# Supabase (or any Postgres). DATABASE_URL is the pooled connection (used at
# runtime, e.g. Supabase's transaction pooler on port 6543 with
# ?pgbouncer=true) — DIRECT_URL is a non-pooled connection (used only by
# Prisma CLI/migrations, e.g. Supabase's session pooler on port 5432).
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me"

PRIVATE_FILE_STORAGE_ROOT="./storage/private"
