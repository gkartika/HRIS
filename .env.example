# Supabase (or any Postgres). DATABASE_URL is the pooled connection (used at
# runtime, e.g. Supabase's transaction pooler on port 6543 with
# ?pgbouncer=true) — DIRECT_URL is a non-pooled connection (used only by
# Prisma CLI/migrations, e.g. Supabase's session pooler on port 5432).
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me"

PRIVATE_FILE_STORAGE_ROOT="./storage/private"

# Email (invitation and password-reset links). Gmail / Google Workspace SMTP:
# create a Google "App password" for SMTP_PASS (not the normal password).
# Without these, links are printed to the server console in development and
# sending fails in production.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="sdm@yourcompany.co.id"
SMTP_PASS="google-app-password"
MAIL_FROM="Aplikasi SDM <sdm@yourcompany.co.id>"
# Public address of the app — used to build the links in those emails.
APP_URL="https://your-app.vercel.app"
# Secret the daily scheduled job (/api/cron/daily) requires.
CRON_SECRET="replace-me-with-a-long-random-string"
