# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# SQLite dev database — real employee PII (NIK, KK, bank accounts, scanned
# documents) lives in here and in every timestamped backup ever taken before
# a risky migration; never let any of them reach a commit.
/dev.db
/dev.db-journal
/dev.db.bak-*
/dev.db.backup-*

# Private file storage (never committed — dev-only fictional documents)
/storage/

# Full-database backups taken before a risky reset/migration against the
# live Supabase Postgres instance — real employee PII, never committed.
/backups/

# Vendor-bundled agent/skill reference docs (from `prisma init`), not project content
/.agents/
/.windsurf/
/.claude/skills/
/skills-lock.json

# Local-only Claude Code session permissions (machine-specific, like .env.local)
/.claude/settings.local.json

.vercel
.env*
