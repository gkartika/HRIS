# Vercel's CLI upload step does not reliably follow .gitignore the same
# way git does — this file exists specifically to guarantee real employee
# PII (dev.db and every timestamped backup) and secrets (.env) never reach
# Vercel's build servers, regardless of git-ignore semantics.
dev.db
dev.db-journal
dev.db.bak-*
dev.db.backup-*
scripts/
storage/
.env
.env.*
!.env.example
node_modules
.next
.git
