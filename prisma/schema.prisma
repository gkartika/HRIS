// PT Cahaya Bukit Perunggu HR App — Prisma schema
// Source of truth for field/entity decisions: docs/DECISIONS.md and the HR App Build Guide /
// HR App Data Fields Blueprint (see CLAUDE.md for links and priority order).
//
// Scope note: this schema currently covers Phase 0 (Foundation), Phase 1
// (Employee & Organization), and Phase 2 (Employee Lifecycle) slices for
// Recruitment and Movement:
// - Recruitment Request -> approval -> Create Employee -> initial Primary
//   Assignment -> fulfillment-link flow (DEC-013, DM-21..DM-23, WF-13..
//   WF-14), corrected so decision authority is Position-derived HR Manager
//   only, with HR Admin as a separate operational account and
//   Requester/HR Manager/HR Admin cancellation (ACC-14..16, WF-15, DM-25,
//   DEC-004/015/016/018).
// - Movement Request -> HR Manager decision -> HR Admin execution flow
//   (LIF-04, Data Fields Blueprint "28 Movement Requests"), reusing the
//   Phase 1 Assignment model rather than rebuilding it.
// - Onboarding Case (LIF-03, Data Fields Blueprint "12 Onboarding"): created
//   automatically alongside every new Employee (direct creation or
//   Recruitment fulfillment), tracked via three admin-owned completion
//   flags (contract/training-material/assets) with a live-computed overall
//   status — never a stored one.
// - Contract + renewal pipeline (WF-10, LIF-08..12, Data Fields Blueprint
//   "08 Contracts"): a single Contract model whose own `status` carries the
//   full WF-10 state machine (an expiring contract moves through the
//   Department-Manager-recommends -> HR-Manager-decides states; an
//   approved renewal creates a NEW Contract row that moves through
//   Draft -> Released -> Signed -> Active while the old one ends).
// - Shared Evaluation (DM-26/27, WF-19, ACC-17, LIF-14): one FR-HC-01-07
//   entity reused by Contract Renewal, Perubahan Posisi and Manual HR.
// - Offboarding (LIF-06/07/12, WF-10, GA-05, DSH-08/09/14): a resignation
//   report or a non-renewal handoff from ContractRenewalCase moves through
//   HR Manager decision -> HR Admin exit-clearance execution + Account
//   Disable, closing (never deleting) the employee's Assignments.
// Explicitly NOT modeled: Manpower, Candidate, Selected Person (DEC-013
// excludes them), plus later phases (Competency, Training, Assets,
// Payroll-slip import) — these belong to later increments and will be
// added when those increments start.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum AccountType {
  EMPLOYEE_LOGIN
  ADMIN
}

// Named admin capability scope. Separate from AppRole: an Account can be ADMIN type
// with a scope AND still be linked to an Employee (e.g. a manager who is also GA admin).
enum AdminScope {
  PEOPLE_PAYROLL
  TRAINING
  ASSETS
  NONE
}

enum AccountStatus {
  INVITED
  ACTIVE
  LOCKED
  DISABLED
}

// Manager/Approver is deliberately NOT a role here — per ACC-05 that authority is
// derived at request time from the employee's active Position assignments
// (does any Position report to me?), never a stored flag.
enum AppRole {
  HR_ADMIN
  TRAINING_ADMIN
  GA_ADMIN
  EMPLOYEE
  // Stand-alone login (no employee record, like the Admin SDM login) for the person who runs
  // the applicant pipeline. Created by Admin SDM under Pengaturan > Akun Admin Rekrutmen;
  // Admin SDM keeps the same access.
  RECRUITMENT_ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum EmploymentStatus {
  PKWTT
  PKWT
  HARIAN_LEPAS
  MAGANG
}

enum UnitType {
  DEPARTMENT
  SECTION
  GROUP
  TEAM
}

enum PositionType {
  STAFF
  TEAM_LEAD
  SECTION_HEAD
  DEPARTMENT_HEAD
  DIRECTOR
}

enum PositionStatus {
  PLANNED
  VACANT
  FILLED
  FROZEN
  CLOSED
}

enum AssignmentType {
  PRIMARY
  ADDITIONAL
  ACTING
  TEMPORARY
}

enum AssignmentStatus {
  ACTIVE
  ENDED
  // A future-dated move to a new primary placement: created now, switches to
  // ACTIVE on its start date (nightly job) while the old placement stays
  // ACTIVE until its end date. Never counts as held before it starts.
  SCHEDULED
}

enum Sensitivity {
  INTERNAL
  RESTRICTED
  HIGHLY_RESTRICTED
}

enum ImportStatus {
  UPLOADED
  VALIDATED
  NEEDS_FIX
  // Being written right now. Set atomically by the first "Import" click, so a
  // second click (or a second tab) cannot write the same rows again.
  POSTING
  POSTED
  ROLLED_BACK
}

// LIF-03 / Data Fields Blueprint "12 Onboarding": computed live from the
// three completion flags + planned_start_date/mandatory_material_due_date —
// never stored directly.
enum OnboardingOverallStatus {
  NOT_STARTED
  IN_PROGRESS
  OVERDUE
  COMPLETE
  CANCELLED
}

// DM-25 / WF-13: who had the authority to cancel a Recruitment Request.
enum CancellationAuthority {
  REQUESTER
  HR_MANAGER
  HR_ADMIN
}

// WF-10: one enum carries the full renewal pipeline. DRAFT/RELEASED/SIGNED
// apply to a brand-new Contract on its way to becoming ACTIVE; ACTIVE is the
// steady state (no renewal in progress); REVIEW_REQUESTED..NOT_RENEWED apply
// to an existing ACTIVE contract as its own end date approaches; ENDED is
// the final historical state once superseded by a newer Contract or expired
// without renewal.
enum ContractStatus {
  DRAFT
  RELEASED
  SIGNED
  ACTIVE
  REVIEW_REQUESTED
  RECOMMENDATION_SUBMITTED
  APPROVED_FOR_RENEWAL
  NOT_RENEWED
  ENDED
}

enum ContractRenewalRecommendation {
  RENEW
  NOT_RENEW
}

enum AuditAction {
  VIEW
  CREATE
  UPDATE
  APPROVE
  REJECT
  IMPORT
  EXPORT
  PRINT
  RELEASE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
}

// ---------- Phase 2: simplified Recruitment Request (DEC-013, DM-21..23) ----------
// Every value below is taken directly from the current FR-HC-01-01 form
// (Formulir Permintaan Tenaga Kerja Baru), per SRC-07.

enum RecruitmentReasonCode {
  REPLACEMENT // Pengganti karyawan keluar
  ADDITIONAL // Penambahan karena kebutuhan
  DEVELOPMENT // Penyesuaian perkembangan PT CBP
}

// Which shift the vacancy works — Shift 1/2/3 only. There is deliberately no
// "non-shift" option here (attendance's own weekly "Libur" is a different
// concept, see ShiftAssignmentType).
// SHIFT and NON_SHIFT are what a new recruitment request offers (text info only);
// SHIFT_1/2/3 stay for requests made before.
enum ShiftCode {
  SHIFT_1
  SHIFT_2
  SHIFT_3
  SHIFT
  NON_SHIFT
}

enum EducationRequirementCode {
  S1_UNIVERSITY // Universitas / S1
  D1_D3_ACADEMY // Akademi D3 / D1
  SMA // SMA Sederajat
}

enum WorkExperienceBand {
  NONE // Tidak Pengalaman
  ONE_TO_TWO // 1-2 tahun
  THREE_TO_FOUR // 3-4 tahun
  MORE_THAN_FIVE // >5 tahun
}

enum AgeBand {
  AGE_18_25
  AGE_26_35
  AGE_36_45
}

enum RequestedJobLevel {
  DEPARTMENT_HEAD
  SECTION_HEAD
  SUPERVISOR
  STAFF_OPERATOR
  HARIAN_LEPAS
}

// WF-13: Draft > Submitted > Under Review > Approved/Rejected/Returned >
// Recruitment In Progress > Partially Filled > Filled > Closed/Cancelled.
// Only Approved, Recruitment In Progress or Partially Filled requests may
// create Employees.
enum RecruitmentRequestStatus {
  DRAFT
  // Department Manager/Head (Job level 3B) approval gate, ahead of the HR
  // Manager — inserted per direct user request. A request only reaches
  // SUBMITTED (the HR Manager's queue) after this stage clears, unless the
  // requester's own current Position is already level 3B in this
  // department, in which case it's skipped entirely.
  PENDING_DEPT_HEAD
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RETURNED
  RECRUITMENT_IN_PROGRESS
  PARTIALLY_FILLED
  FILLED
  CLOSED
  CANCELLED
}

// ---------- Phase 2: Movement Request (LIF-04, Data Fields Blueprint "28 Movement Requests") ----------
// source_evaluation_id, competency_readiness_percent, attendance_summary, and
// training_readiness from the blueprint are deliberately NOT modeled yet —
// they reference Evaluation/Competency/Attendance/Training, none of which
// exist in this app (Phase 3/5). Adding stub FKs to nonexistent datasets now
// would be speculative; revisit when those phases start.

enum MovementType {
  PROMOTION
  ROTATION
  MUTATION
  DEMOTION
  STATUS_CHANGE
}

// Perubahan Posisi refactor (2026-07-31): PENDING_DEPT_HEAD and RETURNED
// added ahead of the Blueprint's original approval_status values, for the
// new Department Head 3B -> HR Manager two-stage approval chain. Purely
// additive — every pre-existing row (any movementType, any of the original
// five statuses) remains a valid row under this enum; nothing was removed.
enum MovementRequestStatus {
  PENDING_DEPT_HEAD
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED
  IMPLEMENTED
  CANCELLED
}

// ---------- Phase 2: Contract Renewal Case (DM-15, DM-26, WF-10..12, LIF-08..13) ----------
// The blueprint's automated D-30 case: FR-HC-01-07's dual-evaluator (P1/P2)
// form, the primary Department Head's recommendation (Level 3B, same
// definition as Perubahan Posisi's dept-head gate — see dept-head.ts), and a
// combined HR Manager decision that can also approve a linked Perubahan
// Posisi draft in one action (DEC-019). This is layered ADDITIVELY next to
// the existing single-recommender Contract fields above (reviewRequestedAt..
// decisionNote) — that manual path remains valid for a renewal not started
// by this automated case; this model owns the richer workflow end to end and
// only touches Contract itself at the very end (via the same
// createRenewalDraftContract/markContractNotRenewed mutations the manual
// path already uses).
enum RenewalRecommendation {
  PERPANJANG_3
  PERPANJANG_6
  PERPANJANG_12
  TIDAK_DIPERPANJANG
  MUTASI
  DEMOSI
}

// WF-10: Upcoming Expiry (D-30) > HR Admin Review > Evaluation Sent >
// [Waiting for P1/P2 is derived live from p1SubmittedAt/p2SubmittedAt, not a
// separate stored state] > Department Head Recommendation [likewise derived
// live from deptHeadRecommendedAt] > Pending HR Manager Combined Review >
// Returned/Rejected/Approved.
enum ContractRenewalCaseStatus {
  TRIGGERED
  EVALUATION_SENT
  PENDING_HR_MANAGER
  RETURNED
  REJECTED
  APPROVED
  CANCELLED
}

// ---------- Phase 2: Shared Evaluation (DM-26, DM-27, WF-19, ACC-17, LIF-14) ----------
// PER-07/DEC-020: one reusable FR-HC-01-07 record and P1/P2 workflow shared
// by every consumer — Contract Renewal (draft at D-30), Perubahan Posisi
// (draft on Promosi/Mutasi/Demosi submission), and HR-Admin-initiated Manual
// HR evaluations. "Do not keep an embedded renewal-only evaluation
// implementation" (WF-19) — this replaces the P1/P2/attendance fields that
// briefly lived directly on ContractRenewalCase (see docs/DECISIONS.md for
// the non-destructive backfill that moved that data here).
//
// The blueprint describes linkage as generic source_type/source_id — this
// schema already reuses concrete typed FKs for source disambiguation
// everywhere else (e.g. MovementRequest.renewalCaseId), so the same idiom is
// used here: the FK lives on the SOURCE record (ContractRenewalCase.
// evaluationId, MovementRequest.evaluationId), not on Evaluation itself.
// That's what makes LIF-13's "renewal-linked Mutasi/Demotasi reuses the
// completed renewal evaluation" representable at all — a renewal case and
// its linked Perubahan Posisi draft can point at the very same Evaluation
// row simultaneously, which a single owning FK on Evaluation could not do.
enum EvaluationPurpose {
  CONTRACT_RENEWAL
  PROMOTION
  MUTATION
  DEMOTION
  MANUAL_HR
}

// WF-19: Draft > Released > [Waiting P1 / Waiting P2 / Waiting Both is
// derived live from p1SubmittedAt/p2SubmittedAt while RELEASED, not a
// separate stored state — same "derive, don't duplicate" pattern already
// used for ContractRenewalCaseStatus] > Completed, with Returned/Cancelled/
// Voided when authorized.
enum EvaluationStatus {
  DRAFT
  RELEASED
  COMPLETED
  RETURNED
  CANCELLED
  VOIDED
}

model Evaluation {
  id               String            @id @default(cuid())
  evaluationNumber String            @unique
  employeeId       String
  employee         Employee          @relation("EvaluationEmployee", fields: [employeeId], references: [id])
  purpose          EvaluationPurpose
  status           EvaluationStatus  @default(DRAFT)

  // DM-27 "primary_assignment_id and organization snapshot" — department/
  // section/position label are re-derived live from snapshotPositionId via
  // the existing level3-scope.ts helpers, same as ContractRenewalCase did.
  primaryAssignmentId String?
  primaryAssignment   Assignment? @relation(fields: [primaryAssignmentId], references: [id])
  snapshotPositionId  String?
  snapshotPosition    Position?   @relation("EvaluationSnapshotPosition", fields: [snapshotPositionId], references: [id])

  createdByAccountId String?
  createdByAccount   Account? @relation("EvaluationCreatedBy", fields: [createdByAccountId], references: [id])
  draftCreatedAt     DateTime @default(now())

  // ACC-17: HR Admin alone assigns P1/P2 and releases — no other role has a
  // release control, regardless of which workflow created the Draft.
  responsibleHrAdminAccountId String?
  responsibleHrAdminAccount   Account?  @relation("EvaluationResponsibleHrAdmin", fields: [responsibleHrAdminAccountId], references: [id])
  releasedByAccountId         String?
  releasedByAccount           Account?  @relation("EvaluationReleasedBy", fields: [releasedByAccountId], references: [id])
  releasedAt                  DateTime?
  evaluationDueDate           DateTime?

  // FR-HC-01-07 HR-owned prefilled attendance snapshot (DM-26).
  attendanceSakit       Int?
  attendanceIjin        Int?
  attendanceAlpha       Int?
  attendanceIjinHalfDay Int?

  // P1/P2 evaluators — must be two different people, each sees/submits only
  // their own assigned evaluation. Itemized FR-HC-01-07 criteria are stored
  // as JSON rather than ~13 mostly-null columns per evaluator, since
  // KPI/Productivity and its 5 alternative criteria are mutually exclusive.
  p1EmployeeId  String?
  p1Employee    Employee? @relation("EvaluationP1Evaluator", fields: [p1EmployeeId], references: [id])
  p1PositionId  String?
  p1Position    Position? @relation("EvaluationP1Position", fields: [p1PositionId], references: [id])
  p1SubmittedAt DateTime?
  p1Scores      Json?
  p1Total       Int?

  p2EmployeeId  String?
  p2Employee    Employee? @relation("EvaluationP2Evaluator", fields: [p2EmployeeId], references: [id])
  p2PositionId  String?
  p2Position    Position? @relation("EvaluationP2Position", fields: [p2PositionId], references: [id])
  p2SubmittedAt DateTime?
  p2Scores      Json?
  p2Total       Int?

  completedAt DateTime?
  cancelledAt DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Reverse of the owning source records' evaluationId FKs — see the note
  // above on why the FK lives on the source, not here.
  contractRenewalCase ContractRenewalCase?
  movementRequest     MovementRequest?

  @@index([employeeId])
  @@index([status])
  @@index([p1EmployeeId])
  @@index([p2EmployeeId])
}

model ContractRenewalCase {
  id                  String     @id @default(cuid())
  caseNumber          String     @unique
  currentContractId   String     @unique
  currentContract     Contract   @relation("RenewalCurrentContract", fields: [currentContractId], references: [id])
  employeeId          String
  employee            Employee   @relation("RenewalCaseEmployee", fields: [employeeId], references: [id])
  // DM-15 "primary_assignment_id and organization snapshot" — department/
  // section are re-derived live via level3-scope.ts's resolveDepartmentId/
  // resolveSectionId from snapshotPositionId, same pattern as
  // MovementRequest's currentPositionId/currentAssignmentId, rather than
  // duplicating department/section text fields that could drift.
  primaryAssignmentId String
  primaryAssignment   Assignment @relation(fields: [primaryAssignmentId], references: [id])
  snapshotPositionId  String
  snapshotPosition    Position   @relation("RenewalSnapshotPosition", fields: [snapshotPositionId], references: [id])

  status      ContractRenewalCaseStatus @default(TRIGGERED)
  triggerDate DateTime                  @default(now())

  // DM-27/WF-19: the shared Evaluation this case created at D-30 (or, for a
  // pre-migration row, backfilled from the fields below during the
  // non-destructive migration — see docs/DECISIONS.md). Every renewal case
  // has exactly one; a linked Mutasi/Demosi Perubahan Posisi draft reuses
  // this same row via its own evaluationId rather than creating another.
  evaluationId String?     @unique
  evaluation   Evaluation? @relation(fields: [evaluationId], references: [id])

  // Primary Department Head recommendation — LIF-09/DEC-019: this
  // recommendation counts as the Dept Head approval for any linked
  // Perubahan Posisi it creates.
  deptHeadEmployeeId             String?
  deptHeadEmployee               Employee?              @relation("RenewalDeptHeadEmployee", fields: [deptHeadEmployeeId], references: [id])
  deptHeadPositionId             String?
  deptHeadPosition               Position?              @relation("RenewalDeptHeadPosition", fields: [deptHeadPositionId], references: [id])
  deptHeadRecommendedAt          DateTime?
  deptHeadRecommendation         RenewalRecommendation?
  deptHeadProposedDurationMonths Int?
  deptHeadProposedPositionId     String?
  deptHeadProposedPosition       Position?              @relation("RenewalDeptHeadProposedPosition", fields: [deptHeadProposedPositionId], references: [id])
  deptHeadNote                   String?

  // Linked Perubahan Posisi draft (DM-10/LIF-13/DEC-019) — created or
  // updated automatically when a Mutasi/Demosi recommendation is in play;
  // voided (cancelled), never deleted, if the final recommendation moves
  // away from Mutasi/Demosi (WF-12).
  linkedMovementRequestId String?          @unique
  linkedMovementRequest   MovementRequest? @relation("RenewalLinkedMovement", fields: [linkedMovementRequestId], references: [id])

  // HR Manager combined decision (WF-12/ACC-16/DEC-019) — one action updates
  // this case AND the linked Perubahan Posisi (if any) together.
  // finalRecommendation may differ from deptHeadRecommendation; a change
  // requires changeReason (mandatory).
  decisionAt          DateTime?
  decisionByAccountId String?
  decisionByAccount   Account?               @relation("RenewalDecisionBy", fields: [decisionByAccountId], references: [id])
  decisionPositionId  String?
  decisionPosition    Position?              @relation("RenewalDecisionPosition", fields: [decisionPositionId], references: [id])
  finalRecommendation RenewalRecommendation?
  changeReason        String?
  decisionNote        String?

  // Contract-generation gating (WF-12: disabled until the linked Perubahan
  // Posisi is approved/executed, then uses the approved new Position) — the
  // new Contract row is created via the same shared helper the manual
  // renewal path uses, never a duplicated mutation.
  generatedContractId String?   @unique
  generatedContract   Contract? @relation("RenewalGeneratedContract", fields: [generatedContractId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Reverse of OffboardingCase.sourceRenewalCaseId — see the note there on
  // why a non-renewal handoff never re-runs this case's own decision.
  offboardingCase OffboardingCase?

  @@index([status])
  @@index([employeeId])
}

enum OffboardingReason {
  RESIGNATION
  CONTRACT_NON_RENEWAL
}

// HR Admin alone opens an offboarding case (resignation or contract non-renewal
// handoff) — no Dept Head / HR Manager approval stage exists. Every case
// therefore starts at PENDING_CLEARANCE.
enum OffboardingCaseStatus {
  PENDING_CLEARANCE
  COMPLETED
  CANCELLED
}

// ---------- Phase 2: Offboarding (LIF-06/07/12, WF-10, GA-05, DSH-08/09/14) ----------
// GA-05 ("Exit Clearance cannot complete while employee-assigned assets
// remain open") is enforced in executeExitClearance() by checking for open
// AssetCustody/GaRequest rows (Phase 4A/4B), plus GA Admin's own explicit
// gaAssetClearanceConfirmedAt sign-off below (Version after UAT) — no longer
// a speculative placeholder.
model OffboardingCase {
  id         String                @id @default(cuid())
  caseNumber String                @unique
  employeeId String
  employee   Employee              @relation("OffboardingCaseEmployee", fields: [employeeId], references: [id])
  reason     OffboardingReason
  status     OffboardingCaseStatus @default(PENDING_CLEARANCE)

  lastWorkingDay   DateTime
  // No explicit day-count rule is given for offboarding anywhere in the
  // Build Guide (unlike Evaluation's WF-18 "5 working days") — documented
  // simplification: clearance is due by the last working day itself.
  clearanceDueDate DateTime

  reportedAt          DateTime @default(now())
  reportedByAccountId String?
  reportedByAccount   Account? @relation("OffboardingReportedBy", fields: [reportedByAccountId], references: [id])
  managerNote         String?

  // LIF-12: traceback to the Contract Renewal Case whose combined HR
  // Manager decision already carries the non-renewal rationale.
  sourceRenewalCaseId String?              @unique
  sourceRenewalCase   ContractRenewalCase? @relation(fields: [sourceRenewalCaseId], references: [id])

  // HR-Admin-maintained "Alasan" dropdown (Pengaturan > Offboarding). Nullable
  // only so cases created before this existed (and contract non-renewal
  // handoffs, which have no HR-picked reason) stay valid.
  exitReasonId String?
  exitReason   OffboardingReasonOption? @relation(fields: [exitReasonId], references: [id])

  // LIF-06's "exit-clearance execution > Account Disable" is one combined
  // HR Admin action, not two gated steps — nothing in the spec describes an
  // intermediate state between them.
  clearanceCompletedAt          DateTime?
  clearanceCompletedByAccountId String?
  clearanceCompletedByAccount   Account?  @relation("OffboardingClearanceCompletedBy", fields: [clearanceCompletedByAccountId], references: [id])
  clearanceNote                 String?

  cancelledAt          DateTime?
  cancelledByAccountId String?
  cancelledByAccount   Account?  @relation("OffboardingCancelledBy", fields: [cancelledByAccountId], references: [id])
  cancellationReason   String?

  // Version after UAT: GA Admin's own explicit sign-off that every asset/GA
  // request tied to this employee has been returned/closed — required
  // alongside (not instead of) the automatic AssetCustody/GaRequest checks
  // in executeExitClearance(), so GA has real accountability rather than a
  // silent system check.
  gaAssetClearanceConfirmedAt   DateTime?
  gaAssetClearanceConfirmedById String?
  gaAssetClearanceConfirmedBy   Account?  @relation("OffboardingGaAssetClearanceConfirmedBy", fields: [gaAssetClearanceConfirmedById], references: [id])
  gaAssetClearanceNote          String?

  // Employee-facing Exit Clearance form (Version after UAT) — informational
  // only, does not gate executeExitClearance(). One submission per case.
  exitClearanceSubmission ExitClearanceSubmission?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@index([status, clearanceDueDate])
}

// Version after UAT: admin-configurable Exit Clearance questions, answered
// once (free text) by the employee themselves when their offboarding case
// reaches PENDING_CLEARANCE. Structurally the same "admin-defined ordered
// items + per-submission answers" shape as the LMS Quiz chain, but with a
// free-text answer instead of multiple-choice options.
// Editable dropdown behind OffboardingCase.exitReason — never deleted, only
// deactivated, so old cases keep showing the reason they were opened with.
model OffboardingReasonOption {
  id           String   @id @default(cuid())
  label        String
  displayOrder Int      @default(0)
  activeFlag   Boolean  @default(true)
  createdAt    DateTime @default(now())

  cases OffboardingCase[]
}

model ExitClearanceQuestion {
  id           String   @id @default(cuid())
  questionText String
  displayOrder Int      @default(0)
  activeFlag   Boolean  @default(true)
  createdAt    DateTime @default(now())

  answers ExitClearanceAnswer[]
}

model ExitClearanceSubmission {
  id                String          @id @default(cuid())
  offboardingCaseId String          @unique
  offboardingCase   OffboardingCase @relation(fields: [offboardingCaseId], references: [id])
  employeeId        String
  employee          Employee        @relation("EmployeeExitClearanceSubmissions", fields: [employeeId], references: [id])
  submittedAt       DateTime        @default(now())

  answers ExitClearanceAnswer[]
  @@index([employeeId])
}

model ExitClearanceAnswer {
  id           String                  @id @default(cuid())
  submissionId String
  submission   ExitClearanceSubmission @relation(fields: [submissionId], references: [id])
  questionId   String
  question     ExitClearanceQuestion   @relation(fields: [questionId], references: [id])
  answerText   String?

  @@unique([submissionId, questionId])
  @@index([questionId])
}

// ---------- Shift Assignment (new, per direct user request) ----------
// One value per employee per calendar week: three rotating shifts plus a
// Non Shift designation, matching the migration template's "shift" lookup
// (Shift1/Shift2/Shift3/NonShift). No separate CUSTOM enum value — an HR
// override just sets any of these four values freely and can add `note` for
// anything the enum doesn't capture (e.g. a temporary WFH arrangement).
enum ShiftAssignmentType {
  SHIFT_1
  SHIFT_2
  SHIFT_3
  NON_SHIFT
}

// ---------- Phase 2 Extension: Attendance & Absence ----------

enum AttendanceMethod {
  MOBILE
  FINGERPRINT
}

enum AttendanceEventType {
  CHECK_IN
  CHECK_OUT
}

enum AttendanceSource {
  MOBILE
  FINGERPRINT_IMPORT
}

// HR-Admin-managed catalog of leave/absence categories — replaces the old
// fixed AbsenceType enum so new categories (and each one's approval shape)
// no longer need a code deploy. `code` is the stable natural key everything
// else joins against (query params, CSV values, the pre-existing seeded
// CUTI/IZIN/SAKIT/LAINNYA rows) — immutable once created; only `label`,
// `requiresFirstApproval` and `activeFlag` are editable afterward.
model AbsenceTypeConfig {
  id                    String   @id @default(cuid())
  code                  String   @unique
  label                 String
  // Per-type approval shape: false skips straight to the mandatory HR Admin
  // stage (e.g. Sakit) instead of the normal two-stage chain. HR Admin
  // approval itself is never optional — always the final gate.
  requiresFirstApproval Boolean  @default(true)
  activeFlag            Boolean  @default(true)
  sortOrder             Int      @default(0)
  updatedAt             DateTime @updatedAt

  // Attendance-tracker migration, per direct request:
  // - employeeRequestable: true for a type an employee can pick when
  //   submitting Ajukan Absensi (Cuti, Izin, ...) — false for a type only
  //   HR assigns after the fact during Rekonsiliasi Absensi (Alpha, Sakit
  //   Tanpa Surat Dokter, ...); never shown on the self-service submit
  //   form when false.
  // - pointsWeight: admin-configurable discipline-score delta per
  //   occurrence (e.g. -2 for STSD, -1 for SDSD), summed per employee into
  //   a running Points total. 0 = no scoring impact. Same value for every
  //   employee — not role/position-dependent.
  // - countsTowardTdl: whether an occurrence counts toward Total Deviasi/
  //   Loss (mandays lost) — off only for Cuti Bersama today.
  // - hoursMultiplier: fraction of that day's scheduled shift hours to
  //   credit toward Total Jam Kerja — 0 (default) = not counted, 1 = paid
  //   in full (e.g. SDSD, IK), 0.5 = half day (SH/Setengah Hari). Only
  //   applies when the classification carries an explicit shiftType (see
  //   DailyAttendanceRecord) — a category entered with no shift never
  //   contributes hours, since there's no schedule to look the figure up
  //   against.
  employeeRequestable Boolean @default(true)
  pointsWeight        Int     @default(0)
  countsTowardTdl     Boolean @default(true)
  hoursMultiplier     Float   @default(0)

  // Per direct request: hard-deleting a type only ever works when nothing
  // real references it (every historical AbsenceRequest/DailyAttendanceRecord
  // would first need migrating to some other type — a real, sometimes
  // judgment-heavy data change). Archiving needs none of that: it's just a
  // visibility flag on an already-deactivated type, hiding it from the main
  // Jenis Absensi list without touching any historical record. Requires
  // activeFlag=false first, same guard hard-delete had.
  archived Boolean @default(false)

  absenceRequests        AbsenceRequest[]
  entitlementConfig      AbsenceEntitlementConfig?
  quotaOverrides         AbsenceQuotaOverride[]
  dailyAttendanceRecords DailyAttendanceRecord[]
}

// No HR Manager stage anywhere in this flow, per direct spec ("Absence does
// not route to HR Manager") — only the configured first-approver Position,
// then HR Admin.
enum AbsenceStatus {
  SUBMITTED
  PENDING_SECOND_APPROVER
  PENDING_HR_ADMIN
  APPROVED
  REJECTED
  CANCELLED
}

// Submitted weekly by a Level-3 (3A/3B) position holder scoped to the
// employee's own department (src/lib/level3-scope.ts, same authority already
// used for Perubahan Posisi submission) — or overridden directly by HR
// Admin, flagged via isHrOverride rather than a second set of actor fields,
// since only the single latest value per employee/week matters (upserted,
// never a history of every past edit — same "current state, not full audit
// trail" simplification as Employee.currentPositionId; full change history
// still lives in AuditLog). @@unique enforces one row per employee per week.
model ShiftAssignment {
  id            String              @id @default(cuid())
  employeeId    String
  employee      Employee            @relation("ShiftAssignmentEmployee", fields: [employeeId], references: [id])
  weekStartDate DateTime
  shiftType     ShiftAssignmentType
  note          String?
  isHrOverride  Boolean             @default(false)

  submittedAt           DateTime  @default(now())
  submittedByAccountId  String
  submittedByAccount    Account   @relation("ShiftAssignmentSubmittedBy", fields: [submittedByAccountId], references: [id])
  submittedByPositionId String?
  submittedByPosition   Position? @relation("ShiftAssignmentSubmittedByPosition", fields: [submittedByPositionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, weekStartDate])
}

// Admin-configurable scheduled work minutes per Shift per day-of-week, per
// direct request ("this will need to be able to be configured within the
// app if we decided to change it") — the source of truth for Total Jam
// Kerja, never hardcoded. dayOfWeek follows JS's Date.getUTCDay() (0=Sunday
// .. 6=Saturday), matching every other date-only value in this app.
// A missing (shiftType, dayOfWeek) row reads as 0 minutes (day off) —
// only real working days need a row, same "absence of a row is the
// default" convention as ShiftAssignment/DEFAULT_SHIFT_TYPE.
// When each shift starts and the grace a check-in gets before it counts as
// late. One row per shift; a null startTime means "not set", which is never late.
model ShiftStartConfig {
  id           String              @id @default(cuid())
  shiftType    ShiftAssignmentType @unique
  startTime    String? // no longer read: the start time is per weekday now, in WorkScheduleConfig.startTime
  graceMinutes Int                 @default(10)
  updatedAt    DateTime            @updatedAt
}

model WorkScheduleConfig {
  id        String              @id @default(cuid())
  shiftType ShiftAssignmentType
  dayOfWeek Int
  minutes   Int                 @default(0)
  // "HH:MM" company (WIB) time this shift starts on this weekday; null = not set, never late.
  startTime String?
  updatedAt DateTime            @updatedAt

  @@unique([shiftType, dayOfWeek])
}

// Bulk-enterable calendar of specific dates, per direct request: "input a
// year of national holiday in one go" instead of classifying every employee
// one by one. TANGGAL_MERAH auto-fills every active employee's day with
// shiftType=NON_SHIFT (no absence code, just "not a scheduled work day",
// same as a weekend); CUTI_BERSAMA auto-fills the existing CTB absence
// type. Both are still just an ordinary DailyAttendanceRecord row after
// that, so HR can overwrite any individual employee's day via Rekonsiliasi
// exactly like any other classification — this table is only the source
// that triggered the bulk fill, not a live override.
enum HolidayType {
  TANGGAL_MERAH
  CUTI_BERSAMA
}

model CompanyHoliday {
  id          String      @id @default(cuid())
  date        DateTime    @unique
  label       String
  holidayType HolidayType
  updatedAt   DateTime    @updatedAt
}

