// ---------- Employee & Organization (Phase 1 core data model) ----------

model Employee {
  id                         String           @id @default(cuid())
  employeeNumber             String           @unique
  fullLegalName              String
  nationalIdNumber           String?
  birthPlace                 String?
  birthDate                  DateTime?
  gender                     Gender?
  personalEmail              String?
  mobileNumber               String?
  // Domisili = where the employee actually lives today; split into DM-blueprint
  // administrative components (RT/RW through postal code) instead of one free-
  // text blob, so it can be printed/matched against government forms cleanly.
  currentAddressLine         String?
  currentAddressRtRw         String?
  currentAddressCity         String?
  currentAddressDistrict     String?
  currentAddressVillage      String?
  currentAddressPostalCode   String?
  // KTP address defaults to "same as domisili" (the common case) — only
  // filled in separately when the employee's ID card lists a different
  // address than where they currently live.
  idCardAddressSameAsCurrent Boolean          @default(true)
  idCardAddressLine          String?
  idCardAddressRtRw          String?
  idCardAddressCity          String?
  idCardAddressDistrict      String?
  idCardAddressVillage       String?
  idCardAddressPostalCode    String?
  emergencyContactName       String?
  emergencyContactRelation   String?
  emergencyContactPhone      String?
  bankAccountName            String?
  bankAccountNumber          String?
  taxId                      String?
  bpjsEmploymentNumber       String?
  bpjsHealthNumber           String?
  // DM-17: Kartu Keluarga number. Text, not numeric — must preserve leading
  // zeroes and is never used as a join/relationship key, just stored/validated
  // as exactly 16 digits (see src/lib/validation/employee-fields.ts).
  noKk                       String?
  namaIbuKandung             String?
  // DM-19/DM-20: admin-maintained dropdowns, stored as a stable reference
  // (row id for education, the code itself for PTKP since that's already a
  // stable regulatory identifier), never free text.
  educationLevelId           String?
  educationLevel             EducationLevel?  @relation(fields: [educationLevelId], references: [id])
  ptkpStatusCode             String?
  ptkpStatus                 PtkpStatus?      @relation(fields: [ptkpStatusCode], references: [code])
  // DM-18/CTL-12: private file references, never a public URL or base64 blob.
  // A new upload creates a new FileObject and repoints this FK — the
  // superseded FileObject row is kept (still linked via FileObject.employeeId)
  // so replacement history isn't lost. KTP/KK are number-only fields now
  // (nationalIdNumber/noKk above) — BPJS cards are the only employee
  // documents still stored as files, downloadable (not editable) by GA
  // Admin and Training Admin too since HSE/GA need them on hand for a
  // workplace accident.
  bpjsTkFileId               String?          @unique
  bpjsTkFile                 FileObject?      @relation("EmployeeBpjsTkFile", fields: [bpjsTkFileId], references: [id])
  bpjsKesehatanFileId        String?          @unique
  bpjsKesehatanFile          FileObject?      @relation("EmployeeBpjsKesehatanFile", fields: [bpjsKesehatanFileId], references: [id])
  hireDate                   DateTime?
  employmentStatus           EmploymentStatus
  // Denormalized pointer to the Position of this employee's current Primary
  // Assignment, kept in sync by application code. Source of truth for history
  // and for "who holds what" is always the Assignment table, never this field.
  currentPositionId          String?
  currentPosition            Position?        @relation("PositionHolder", fields: [currentPositionId], references: [id])
  activeFlag                 Boolean          @default(true)
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  account                        Account?
  assignments                    Assignment[]                   @relation("EmployeeAssignments")
  files                          FileObject[]
  recruitmentRequestsSubmitted   RecruitmentRequest[]           @relation("RecruitmentRequester")
  recruitmentFulfillment         RecruitmentRequestFulfillment?
  recruitmentRequestsCancelled   RecruitmentRequest[]           @relation("RecruitmentCancelledByEmployee")
  recruitmentCandidates          RecruitmentCandidate[]         @relation("RecruitmentCandidateEmployee")
  recruitmentTestReviews         RecruitmentTestReviewer[]      @relation("RecruitmentTestReviewerEmployee")
  recruitmentInterviews          RecruitmentInterviewer[]       @relation("RecruitmentInterviewerEmployee")
  movementRequests               MovementRequest[]              @relation("MovementEmployee")
  movementRequestsSubmitted      MovementRequest[]              @relation("MovementRequester")
  movementRequestsCancelled      MovementRequest[]              @relation("MovementCancelledByEmployee")
  onboardingCase                 OnboardingCase?
  assetCustodies                 AssetCustody[]                 @relation("AssetCustodyEmployee")
  consumableIssues               ConsumableTransaction[]        @relation("ConsumableTxEmployee")
  contracts                      Contract[]                     @relation("EmployeeContracts")
  contractRecommendationsGiven   Contract[]                     @relation("ContractRecommendationBy")
  renewalCases                   ContractRenewalCase[]          @relation("RenewalCaseEmployee")
  renewalDeptHeadRecommendations ContractRenewalCase[]          @relation("RenewalDeptHeadEmployee")
  evaluations                    Evaluation[]                   @relation("EvaluationEmployee")
  evaluationsAsP1                Evaluation[]                   @relation("EvaluationP1Evaluator")
  evaluationsAsP2                Evaluation[]                   @relation("EvaluationP2Evaluator")
  offboardingCases               OffboardingCase[]              @relation("OffboardingCaseEmployee")
  exitClearanceSubmissions       ExitClearanceSubmission[]      @relation("EmployeeExitClearanceSubmissions")
  shiftAssignments               ShiftAssignment[]              @relation("ShiftAssignmentEmployee")
  attendanceAssignments          AttendanceAssignment[]         @relation("AttendanceAssignmentEmployee")
  attendanceEvents               AttendanceEvent[]              @relation("AttendanceEventEmployee")
  dailyAttendanceRecords         DailyAttendanceRecord[]        @relation("DailyAttendanceRecordEmployee")
  absenceRequests                AbsenceRequest[]               @relation("AbsenceRequestEmployee")
  absenceQuotaOverrides          AbsenceQuotaOverride[]         @relation("AbsenceQuotaOverrideEmployee")
  taskForceMemberships           TaskForceMembership[]          @relation("TaskForceMember")

  competencyAssessments                       CompetencyAssessment[]      @relation("CompetencyAssessmentEmployee")
  competencyAssessmentsAsP1                   CompetencyAssessment[]      @relation("CompetencyAssessmentP1")
  competencyAssessmentsAsP2                   CompetencyAssessment[]      @relation("CompetencyAssessmentP2")
  competencyEvaluatorChangesAsOld             CompetencyEvaluatorChange[] @relation("CompetencyEvaluatorChangeOld")
  competencyEvaluatorChangesAsNew             CompetencyEvaluatorChange[] @relation("CompetencyEvaluatorChangeNew")
  trainingRequests                            TrainingRequest[]           @relation("TrainingRequestEmployee")
  learningAssignments                         LearningAssignment[]        @relation("LearningAssignmentEmployee")
  learningAssignmentsAsEffectivenessEvaluator LearningAssignment[]        @relation("LearningAssignmentEffectivenessEvaluator")
  mandatoryTrainingRuleTargets                MandatoryTrainingRule[]     @relation("MandatoryTrainingRuleTargetEmployee")

  gaRequests GaRequest[] @relation("GaRequestRequester")

  @@index([currentPositionId])
  @@index([activeFlag])
}

// DM-19: admin-maintained master list for Pendidikan Terakhir. Managed via
// /admin/education-levels — never hand-edited in the database.
model EducationLevel {
  id           String   @id @default(cuid())
  label        String   @unique
  displayOrder Int      @default(0)
  activeFlag   Boolean  @default(true)
  createdAt    DateTime @default(now())

  employees Employee[]
}

// DM-20: admin-maintained PTKP (Indonesian income-tax status) codes. The
// code itself is stable (regulatory), but the list of codes/labels is
// editable by HR Admin without a code change — managed via /admin/ptkp-status.
model PtkpStatus {
  id           String   @id @default(cuid())
  code         String   @unique
  label        String
  displayOrder Int      @default(0)
  activeFlag   Boolean  @default(true)
  createdAt    DateTime @default(now())

  employees Employee[]
}

model OrgUnit {
  id            String    @id @default(cuid())
  unitType      UnitType
  unitCode      String    @unique
  unitName      String
  parentUnitId  String?
  parentUnit    OrgUnit?  @relation("OrgUnitHierarchy", fields: [parentUnitId], references: [id])
  children      OrgUnit[] @relation("OrgUnitHierarchy")
  displayOrder  Int       @default(0)
  activeFlag    Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  positions              Position[]
  recruitmentRequests    RecruitmentRequest[]
  absenceApproverConfig  AbsenceApproverConfig?
  jobsWithDefaultOrgUnit Job[]

  competencyAssessments        CompetencyAssessment[]
  trainingRequestsSnapshot     TrainingRequest[]
  mandatoryTrainingRuleTargets MandatoryTrainingRule[]
  assetCustodies               AssetCustody[]
  consumableIssues             ConsumableTransaction[] @relation("ConsumableTxOrgUnit")

  @@index([parentUnitId])
}

model Job {
  id             String   @id @default(cuid())
  jobCode        String   @unique
  jobTitle       String
  jobPurpose     String?
  approvalStatus String   @default("Approved")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Optional convenience defaults — per direct request, so re-selecting the
  // same Job for a new Position doesn't require re-picking its usual
  // OrgUnit/PositionType every time. Deliberately NOT authoritative: only
  // pre-fills the Position create form (create-form.tsx), never written
  // back onto Position.orgUnitId/positionType directly and never enforced
  // on save — a Position can still diverge from its Job's default (the
  // same Job legitimately used across different units/tiers), same
  // reasoning as jobLevel staying per-seat on Position, not on Job.
  defaultOrgUnitId    String?
  defaultOrgUnit      OrgUnit?      @relation(fields: [defaultOrgUnitId], references: [id])
  defaultPositionType PositionType?

  positions           Position[]
  recruitmentRequests RecruitmentRequest[]
  recruitmentJobTests RecruitmentJobTest[]

  competencyRequirements       PositionCompetencyRequirement[]
  competencyAssessments        CompetencyAssessment[]          @relation("CompetencyAssessmentJob")
  mandatoryTrainingRuleTargets MandatoryTrainingRule[]
}

model Position {
  id                    String         @id @default(cuid())
  positionCode          String         @unique
  jobId                 String
  job                   Job            @relation(fields: [jobId], references: [id])
  // Per direct user request: level is a per-seat attribute, not a property
  // of the abstract Job — the same Job (e.g. "Operator CNC") is held at
  // different grades across different Positions (e.g. "1B Operator CNC" vs
  // "1C Operator CNC"), matching the real org data and the migration
  // template's own 04_POSITIONS.job_level_code column (03_JOBS carries no
  // level at all). Deliberately not duplicated onto Job too — one place to
  // hold level, not two.
  jobLevel              String
  orgUnitId             String
  orgUnit               OrgUnit        @relation(fields: [orgUnitId], references: [id])
  positionType          PositionType
  positionStatus        PositionStatus @default(VACANT)
  // Hides a defunct Position from every "pick a Position" dropdown going
  // forward (reportsTo, new Assignment, Movement, Recruitment fulfillment,
  // Contract renewal, org chart) without deleting the row — every workflow
  // table above holds a hard FK into Position with no cascade, so historical
  // references must survive. Only settable once positionStatus is CLOSED
  // (see archivePosition in admin/positions/actions.ts).
  archived              Boolean        @default(false)
  // ACC-14/DEC-015: functional flag, independent of positionType's hierarchy
  // tier. An Employee holding an ACTIVE Assignment (any type) to a Position
  // with this flag set derives HR Manager authority live — never a stored
  // AccountRole, so access starts/ends automatically with the Assignment's
  // effective dates. See src/lib/hr-manager.ts.
  grantsHrManagerAccess Boolean        @default(false)
  // Sole saved parent-child authority for the org chart (ORG-01). Never inferred
  // from names or job levels.
  reportsToPositionId   String?
  reportsToPosition     Position?      @relation("PositionHierarchy", fields: [reportsToPositionId], references: [id])
  subordinatePositions  Position[]     @relation("PositionHierarchy")
  effectiveFrom         DateTime       @default(now())
  effectiveTo           DateTime?

  currentHolders                          Employee[]              @relation("PositionHolder")
  assignments                             Assignment[]
  requesterForRecruitment                 RecruitmentRequest[]    @relation("RequesterPosition")
  recruitmentDecisions                    RecruitmentRequest[]    @relation("RecruitmentDecisionPosition")
  recruitmentDeptHeadDecisions            RecruitmentRequest[]    @relation("RecruitmentDeptHeadDecisionPosition")
  movementRequestsAsCurrent               MovementRequest[]       @relation("MovementCurrentPosition")
  movementRequestsAsProposed              MovementRequest[]       @relation("MovementProposedPosition")
  movementRequestsAsRequesterPosition     MovementRequest[]       @relation("MovementRequesterPosition")
  movementRequestsDecisions               MovementRequest[]       @relation("MovementDecisionPosition")
  movementRequestsDeptHeadDecisions       MovementRequest[]       @relation("MovementDeptHeadDecisionPosition")
  contractRecommendations                 Contract[]              @relation("ContractRecommendationPosition")
  contractDecisions                       Contract[]              @relation("ContractDecisionPosition")
  renewalSnapshotOf                       ContractRenewalCase[]   @relation("RenewalSnapshotPosition")
  renewalDeptHeadPositionOf               ContractRenewalCase[]   @relation("RenewalDeptHeadPosition")
  renewalDeptHeadProposedPositionOf       ContractRenewalCase[]   @relation("RenewalDeptHeadProposedPosition")
  renewalDecisionPositionOf               ContractRenewalCase[]   @relation("RenewalDecisionPosition")
  evaluationsAsSnapshotPosition           Evaluation[]            @relation("EvaluationSnapshotPosition")
  evaluationsAsP1Position                 Evaluation[]            @relation("EvaluationP1Position")
  evaluationsAsP2Position                 Evaluation[]            @relation("EvaluationP2Position")
  contractsReleasedByPositionOf           Contract[]              @relation("ContractReleasedByPosition")
  shiftAssignmentsSubmittedByPositionOf   ShiftAssignment[]       @relation("ShiftAssignmentSubmittedByPosition")
  absenceApproverConfigOf                 AbsenceApproverConfig[] @relation("AbsenceApproverPosition")
  absenceRequestsAsFirstApproverPosition  AbsenceRequest[]        @relation("AbsenceFirstApproverPosition")
  absenceRequestsAsSecondApproverPosition AbsenceRequest[]        @relation("AbsenceSecondApproverPosition")

  competencyAssessmentsAsSnapshotPosition    CompetencyAssessment[]  @relation("CompetencyAssessmentPosition")
  competencyAssessmentsAsP1Position          CompetencyAssessment[]  @relation("CompetencyAssessmentP1Position")
  competencyAssessmentsAsP2Position          CompetencyAssessment[]  @relation("CompetencyAssessmentP2Position")
  trainingRequestsAsPositionSnapshot         TrainingRequest[]       @relation("TrainingRequestPositionSnapshot")
  trainingRequestsAsDeptHeadDecisionPosition TrainingRequest[]       @relation("TrainingRequestDeptHeadDecisionPosition")
  mandatoryTrainingRuleTargetPositionOf      MandatoryTrainingRule[] @relation("MandatoryTrainingRuleTargetPosition")

  @@index([orgUnitId])
  @@index([reportsToPositionId])
  @@index([jobId])
}

model Assignment {
  id                    String           @id @default(cuid())
  employeeId            String
  employee              Employee         @relation("EmployeeAssignments", fields: [employeeId], references: [id])
  positionId            String
  position              Position         @relation(fields: [positionId], references: [id])
  assignmentType        AssignmentType
  primaryAssignmentFlag Boolean          @default(false)
  status                AssignmentStatus @default(ACTIVE)
  // Start date of the placement. Blank = not known (e.g. bulk-imported without
  // dates); it is then treated as already in force.
  effectiveFrom         DateTime?
  effectiveTo           DateTime?
  createdAt             DateTime         @default(now())

  fulfillment                              RecruitmentRequestFulfillment?
  movementImplementation                   MovementRequest?
  movementCurrentAssignmentOf              MovementRequest[]              @relation("MovementCurrentAssignment")
  renewalCasesAsPrimaryAssignment          ContractRenewalCase[]
  evaluationsAsPrimaryAssignment           Evaluation[]
  contractsAsPrimaryAssignment             Contract[]                     @relation("ContractPrimaryAssignment")
  competencyAssessmentsAsPrimaryAssignment CompetencyAssessment[]

  @@index([employeeId, status])
  @@index([positionId, status])
}

// ---------- Phase 2: Recruitment Request (DEC-013, DM-21..23, WF-13..14) ----------

model RecruitmentRequest {
  id                       String                   @id @default(cuid())
  requestNumber            String                   @unique
  requestDate              DateTime
  reasonCode               RecruitmentReasonCode
  departmentId             String
  department               OrgUnit                  @relation(fields: [departmentId], references: [id])
  // Removed from the submitter's form on direct user request — the
  // requester no longer picks Job themselves. The active HR Manager sets it
  // as part of the Approve decision instead (decideRecruitmentRequest),
  // since it's still needed to filter candidate Positions when creating the
  // Employee later. Nullable so a request can exist in Submitted/Under
  // Review with no Job chosen yet.
  jobId                    String?
  job                      Job?                     @relation(fields: [jobId], references: [id])
  // Specific approved seat, when one is already known/vacant (DM-21: "when
  // available") — otherwise HR resolves a Position at fulfillment time.
  shiftCode                ShiftCode
  requestedHeadcount       Int
  jobDescriptionSnapshot   String
  educationRequirementCode EducationRequirementCode
  workExperienceBand       WorkExperienceBand
  ageBand                  AgeBand
  genderRequirement        Gender?
  requestedJobLevel        RequestedJobLevel
  specialCriteria          String?
  status                   RecruitmentRequestStatus @default(DRAFT)

  requesterEmployeeId String
  requesterEmployee   Employee  @relation("RecruitmentRequester", fields: [requesterEmployeeId], references: [id])
  // The Position through which the requester was acting when submitting —
  // authority/approvals must retain Position context, never just the person.
  requesterPositionId String?
  requesterPosition   Position? @relation("RequesterPosition", fields: [requesterPositionId], references: [id])

  submittedAt                 DateTime?
  submittedByAccountId        String?
  submittedByAccount          Account?  @relation("RecruitmentSubmittedBy", fields: [submittedByAccountId], references: [id])
  // Department Manager/Head (Job level 3B, scoped to this request's own
  // department) decision — runs before the HR Manager ever sees the
  // request. Same evidence shape as HR Manager's own decision fields below,
  // kept separate so both stages' evidence survive independently even
  // though they share the same REJECTED/RETURNED status outcomes.
  deptHeadDecisionAt          DateTime?
  deptHeadDecisionByAccountId String?
  deptHeadDecisionByAccount   Account?  @relation("RecruitmentDeptHeadDecisionBy", fields: [deptHeadDecisionByAccountId], references: [id])
  deptHeadDecisionPositionId  String?
  deptHeadDecisionPosition    Position? @relation("RecruitmentDeptHeadDecisionPosition", fields: [deptHeadDecisionPositionId], references: [id])
  deptHeadDecisionNote        String?
  // WF-15: only the Employee occupying an active HR Manager Position may
  // decide (approve/reject/return). approvedByAccountId records who (the
  // login used); decisionPositionId records the specific HR Manager Position
  // that gave them authority for THIS decision (WF-02/WF-05 — required when
  // an Employee holds more than one qualifying Position).
  approvedAt                  DateTime?
  approvedByAccountId         String?
  approvedByAccount           Account?  @relation("RecruitmentApprovedBy", fields: [approvedByAccountId], references: [id])
  decisionPositionId          String?
  decisionPosition            Position? @relation("RecruitmentDecisionPosition", fields: [decisionPositionId], references: [id])
  decisionNote                String?

  // DM-25: cancellation is a distinct action from Approve/Reject/Return.
  // Requester, HR Manager or HR Admin may cancel from an eligible state
  // (never Filled/Closed/already-Cancelled); the request row is never
  // deleted and existing fulfillment links are always preserved.
  cancelledAt           DateTime?
  cancelledByAccountId  String?
  cancelledByAccount    Account?                  @relation("RecruitmentCancelledByAccount", fields: [cancelledByAccountId], references: [id])
  cancelledByEmployeeId String?
  cancelledByEmployee   Employee?                 @relation("RecruitmentCancelledByEmployee", fields: [cancelledByEmployeeId], references: [id])
  cancellationAuthority CancellationAuthority?
  cancellationReason    String?
  previousStatus        RecruitmentRequestStatus?

  // Closing a partly filled request ("Tutup"): hiring stops with fewer people
  // than requested. Distinct from cancelling, which is for requests that
  // never produced a hire. The hires already made stay linked.
  closedAt          DateTime?
  closedByAccountId String?
  closedByAccount   Account?  @relation("RecruitmentClosedByAccount", fields: [closedByAccountId], references: [id])
  closeReason       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fulfillments RecruitmentRequestFulfillment[]

  // Applicant pipeline. NONE = not published; the access code is what an external
  // applicant types on /cbp-recruitment (one code per request).
  openFor         RecruitmentOpenFor     @default(NONE)
  accessCode      String?
  // Tests chosen for this vacancy. Not customised = the job title's own tests from Pengaturan Rekrutmen
  // apply; customised = exactly testTypeIds (Cultural Fit is always required on top, so it is not listed).
  testsCustomized Boolean                @default(false)
  testTypeIds     String[]               @default([])
  candidates      RecruitmentCandidate[]

  @@index([status])
  @@index([departmentId])
  @@index([jobId])
  @@index([requesterEmployeeId])
}

// DM-23: supports multiple Employees per request, up to requestedHeadcount.
// filled_count/remaining_count are always derived from this table, never
// stored — see src/lib/recruitment.ts.
model RecruitmentRequestFulfillment {
  id                   String             @id @default(cuid())
  recruitmentRequestId String
  recruitmentRequest   RecruitmentRequest @relation(fields: [recruitmentRequestId], references: [id])
  employeeId           String             @unique
  employee             Employee           @relation(fields: [employeeId], references: [id])
  assignmentId         String             @unique
  assignment           Assignment         @relation(fields: [assignmentId], references: [id])
  linkedAt             DateTime           @default(now())
  linkedByAccountId    String
  linkedByAccount      Account            @relation(fields: [linkedByAccountId], references: [id])
  @@index([recruitmentRequestId])
}

// ---------- Phase 2: Movement Request (LIF-04) ----------
// WF-17 decision-to-execution pattern: an authorized manager (or HR Admin)
// submits/recommends -> the active HR Manager Position approves or rejects
// -> HR Admin executes the effective-dated Assignment change. This is a
// *formal* path alongside the existing direct "Pindahkan ke Posisi Baru"
// HR-Admin action on the Employee page (kept as an administrative
// shortcut/correction tool, same direct-vs-formal-request precedent as
// DEC-014 for Employee creation) — see docs/DECISIONS.md.
model MovementRequest {
  id                       String                @id @default(cuid())
  requestNumber            String                @unique
  employeeId               String
  employee                 Employee              @relation("MovementEmployee", fields: [employeeId], references: [id])
  movementType             MovementType
  // Captured at submission time from Employee.currentPositionId — a
  // snapshot, since the employee's actual current position could change
  // before this request is decided/executed.
  currentPositionId        String
  currentPosition          Position              @relation("MovementCurrentPosition", fields: [currentPositionId], references: [id])
  // Perubahan Posisi refactor: the specific Assignment being changed —
  // required so execution acts on exactly the Assignment the requester
  // identified, not whatever happens to be "the Primary" at execution time
  // (which could differ if something else changed in between). Nullable
  // only because pre-refactor rows predate this field.
  currentAssignmentId      String?
  currentAssignment        Assignment?           @relation("MovementCurrentAssignment", fields: [currentAssignmentId], references: [id])
  // Required for every movementType, incl. STATUS_CHANGE (where it's the
  // same as currentPositionId — no position change, only employmentStatus).
  proposedPositionId       String
  proposedPosition         Position              @relation("MovementProposedPosition", fields: [proposedPositionId], references: [id])
  // Only meaningful/required when movementType is STATUS_CHANGE — a legacy
  // type, no longer offered by the Perubahan Posisi submit form.
  proposedEmploymentStatus EmploymentStatus?
  proposedEffectiveDate    DateTime
  requestReason            String
  status                   MovementRequestStatus @default(SUBMITTED)

  requesterEmployeeId  String
  requesterEmployee    Employee  @relation("MovementRequester", fields: [requesterEmployeeId], references: [id])
  requesterPositionId  String?
  requesterPosition    Position? @relation("MovementRequesterPosition", fields: [requesterPositionId], references: [id])
  submittedAt          DateTime  @default(now())
  submittedByAccountId String
  submittedByAccount   Account   @relation("MovementSubmittedBy", fields: [submittedByAccountId], references: [id])

  // Perubahan Posisi refactor: Department Head 3B decision (first stage),
  // same evidence shape as the HR Manager's own decision fields below —
  // kept separate so both stages' evidence survive independently.
  deptHeadDecisionAt          DateTime?
  deptHeadDecisionByAccountId String?
  deptHeadDecisionByAccount   Account?  @relation("MovementDeptHeadDecisionBy", fields: [deptHeadDecisionByAccountId], references: [id])
  deptHeadDecisionPositionId  String?
  deptHeadDecisionPosition    Position? @relation("MovementDeptHeadDecisionPosition", fields: [deptHeadDecisionPositionId], references: [id])
  deptHeadDecisionNote        String?

  // LIF-04: "HR Manager approves or rejects" (second/final stage) —
  // decisionPositionId records which active HR Manager Position gave
  // authority (WF-02/WF-05), same pattern as RecruitmentRequest.
  decisionAt          DateTime?
  decisionByAccountId String?
  decisionByAccount   Account?  @relation("MovementDecisionBy", fields: [decisionByAccountId], references: [id])
  decisionPositionId  String?
  decisionPosition    Position? @relation("MovementDecisionPosition", fields: [decisionPositionId], references: [id])
  decisionNote        String?

  // Perubahan Posisi refactor: HR-only supporting fields (FR-HC-01-09's
  // "Absensi 3 Bulan Terakhir" + evaluation reference) — added/verified by
  // HR Admin, never visible or editable by the requester. Evaluation
  // reference is mandatory for Promosi (validated in the action, not here).
  attendanceAlpha          Int?
  attendanceSakit          Int?
  attendanceIjin           Int?
  attendanceIjinHalfDay    Int?
  attendanceCuti           Int?
  // Superseded by the shared Evaluation below (WF-19/DEC-020) — kept only as
  // an optional HR-only supplementary note/legacy field for pre-refactor
  // rows, no longer required or treated as "the evaluation" for any type.
  performanceEvaluationRef String?
  hrConfidentialNotes      String?

  // DM-27/WF-17/LIF-14: every Promosi, Mutasi or Demotasi auto-creates one
  // linked Evaluation Draft on submission (never a requester trigger) —
  // except a renewal-linked draft, which reuses its Contract Renewal Case's
  // already-existing Evaluation instead of creating a new one (LIF-13).
  // Department Head 3B and HR Manager approval both wait for this
  // Evaluation to reach Completed.
  evaluationId String?     @unique
  evaluation   Evaluation? @relation(fields: [evaluationId], references: [id])

  // LIF-04: "HR Admin executes the future/effective-dated Position
  // Assignment and preserves previous records" — implementedAssignmentId
  // points at the new Assignment row created by execution (old Assignment
  // is closed, never overwritten, same as the direct Movement action).
  implementedAt           DateTime?
  implementedByAccountId  String?
  implementedByAccount    Account?    @relation("MovementImplementedBy", fields: [implementedByAccountId], references: [id])
  implementedAssignmentId String?     @unique
  implementedAssignment   Assignment? @relation(fields: [implementedAssignmentId], references: [id])

  // DM-25-style cancellation, reusing the same CancellationAuthority enum
  // as Recruitment for consistency. Only eligible from SUBMITTED/APPROVED.
  cancelledAt           DateTime?
  cancelledByAccountId  String?
  cancelledByAccount    Account?               @relation("MovementCancelledByAccount", fields: [cancelledByAccountId], references: [id])
  cancelledByEmployeeId String?
  cancelledByEmployee   Employee?              @relation("MovementCancelledByEmployee", fields: [cancelledByEmployeeId], references: [id])
  cancellationAuthority CancellationAuthority?
  cancellationReason    String?
  previousStatus        MovementRequestStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // DM-10/LIF-13: set only for a draft auto-created by the Contract Renewal
  // workflow (Mutasi/Demosi outcome) — reverse of ContractRenewalCase's
  // linkedMovementRequestId.
  renewalCase ContractRenewalCase? @relation("RenewalLinkedMovement")

  // Set when HR Admin opened this request from an internal applicant.
  recruitmentCandidate RecruitmentCandidate? @relation("RecruitmentCandidateMovement")

  @@index([employeeId])
  @@index([status])
  @@index([requesterEmployeeId])
}

// ---------- Phase 2: Onboarding Case (LIF-03, Data Fields Blueprint "12 Onboarding") ----------
// Created automatically alongside every new Employee (direct creation or
// Recruitment fulfillment) — "reuse the Employee and initial Position
// Assignment; do not re-enter identity data." Three completion flags, each
// with its own admin owner per the blueprint (People & Payroll / Training /
// Assets); candidate_id, asset_requirement_profile, and other fields tied to
// Candidate/Competency/Asset datasets that don't exist yet in this app are
// deliberately not modeled — same reasoning as Movement Request's deferred
// Evaluation/Competency fields.
model OnboardingCase {
  id               String   @id @default(cuid())
  caseNumber       String   @unique
  employeeId       String   @unique
  employee         Employee @relation(fields: [employeeId], references: [id])
  plannedStartDate DateTime

  contractComplete             Boolean   @default(false)
  contractCompletedAt          DateTime?
  contractCompletedByAccountId String?
  contractCompletedByAccount   Account?  @relation("OnboardingContractCompletedBy", fields: [contractCompletedByAccountId], references: [id])

  // "Materi Wajib" completion is derived live from real LearningAssignment
  // completion (see lib/mandatory-training.ts's
  // getOnboardingTrainingStatusesForEmployee / lib/onboarding.ts's
  // isOnboardingTrainingComplete) — never a manual toggle, unlike contract
  // above. Only the checklist's own target date remains a real stored input
  // (there's no per-course due-date concept anywhere in this app).
  mandatoryMaterialDueDate DateTime?

  // Phase 4A: "Perlengkapan Selesai" completion is likewise derived live
  // from real AssetCustody rows for the employee (lib/onboarding.ts's
  // isOnboardingAssetsComplete) — no stored flag, same reasoning as
  // mandatoryMaterialDueDate above.

  // Set automatically the moment all flags become true — never hand-set,
  // and overall_status (Not Started/In Progress/Overdue/Complete) is
  // computed live from these fields, never stored (src/lib/onboarding.ts).
  completedAt DateTime?

  // Cancelled (no-show, hired by mistake, left during onboarding). The row is
  // kept; reopening clears these three fields.
  cancelledAt          DateTime?
  cancelledByAccountId String?
  cancelledByAccount   Account?  @relation("OnboardingCancelledBy", fields: [cancelledByAccountId], references: [id])
  cancellationReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

// ---------- Phase 2: Contract + renewal pipeline (WF-10, LIF-08..12) ----------
// Data Fields Blueprint "08 Contracts" has no separate renewal-case
// dataset — its own contract_id/drafted_at/released_at/signed_at fields are
// the only place WF-10's pipeline can live, so this single model plays two
// roles depending on where it sits in that pipeline: (1) an ACTIVE contract
// nearing its own end_date, moving through the Department-Manager-
// recommends -> HR-Manager-decides states; (2) once approved, a brand-new
// Contract row moving Draft -> Released -> Signed -> Active while the old
// one (linked via renewedFromContractId) flips to Ended. "Not Renewed"
// records the reason (LIF-12) but does not create an actual offboarding
// handoff — Offboarding doesn't exist yet in this app; revisit when it does.
model Contract {
  id             String           @id @default(cuid())
  contractNumber String           @unique
  employeeId     String
  employee       Employee         @relation("EmployeeContracts", fields: [employeeId], references: [id])
  contractType   EmploymentStatus
  startDate      DateTime
  // Blueprint: "blank for indefinite contract" — null means PKWTT/indefinite.
  endDate        DateTime?
  status         ContractStatus   @default(DRAFT)

  // Per direct user request (migration 11_FIELD_MAP's primary_assignment_code):
  // which Assignment/Position this contract belongs to, since an Employee
  // may hold multiple Positions over time. Optional at the schema level —
  // every new/generated contract must capture it (enforced in the action
  // layer, e.g. resolved from the employee's active Primary Assignment, or
  // from a Mutasi/Demosi's own implementedAssignmentId when contract
  // generation follows a Movement's execution) — a legacy contract created
  // before this field existed may remain blank.
  primaryAssignmentId String?
  primaryAssignment   Assignment? @relation("ContractPrimaryAssignment", fields: [primaryAssignmentId], references: [id])

  // Set when this Contract is a renewal — the Contract it replaces.
  renewedFromContractId String?   @unique
  renewedFromContract   Contract? @relation("ContractRenewalChain", fields: [renewedFromContractId], references: [id])
  renewedByContract     Contract? @relation("ContractRenewalChain")

  // Department Manager recommendation (WF-10/LIF-09 step 1). WF-02:
  // "approval evidence" always records the Position context too, not just
  // the person — same pattern as Recruitment/Movement requesters.
  reviewRequestedAt          DateTime?
  recommendationSubmittedAt  DateTime?
  recommendationByEmployeeId String?
  recommendationByEmployee   Employee?                      @relation("ContractRecommendationBy", fields: [recommendationByEmployeeId], references: [id])
  recommendationByPositionId String?
  recommendationByPosition   Position?                      @relation("ContractRecommendationPosition", fields: [recommendationByPositionId], references: [id])
  recommendation             ContractRenewalRecommendation?
  recommendationNote         String?

  // HR Manager decision (WF-10/LIF-09 step 2) — same Position-derived-only
  // authority as Recruitment (WF-15) and Movement, reused for consistency.
  decisionAt          DateTime?
  decisionByAccountId String?
  decisionByAccount   Account?  @relation("ContractDecisionBy", fields: [decisionByAccountId], references: [id])
  decisionPositionId  String?
  decisionPosition    Position? @relation("ContractDecisionPosition", fields: [decisionPositionId], references: [id])
  decisionNote        String?
  notRenewedReason    String?

  // HR Admin prepares (draft/sign/activate); Employee signs their own
  // contract (blueprint: signed_at's Primary Owner is "Employee"). Release
  // is the one exception — per direct user request, releasing a Draft to
  // the employee now needs an active HR Manager Position's approval (same
  // Position-derived-only authority as every other HR Manager decision in
  // this app), not HR Admin alone, so unlike draft/sign/activate it carries
  // its own actor+Position evidence fields (WF-02).
  draftedAt            DateTime?
  releasedAt           DateTime?
  releasedByAccountId  String?
  releasedByAccount    Account?  @relation("ContractReleasedBy", fields: [releasedByAccountId], references: [id])
  releasedByPositionId String?
  releasedByPosition   Position? @relation("ContractReleasedByPosition", fields: [releasedByPositionId], references: [id])
  signedAt             DateTime?
  activatedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  renewalCaseAsCurrentContract   ContractRenewalCase? @relation("RenewalCurrentContract")
  renewalCaseAsGeneratedContract ContractRenewalCase? @relation("RenewalGeneratedContract")

  @@index([employeeId])
  @@index([status])
}

// ---------- Controls: audit, import, private files ----------

model AuditLog {
  id                String      @id @default(cuid())
  eventAt           DateTime    @default(now())
  actorAccountId    String?
  actorAccount      Account?    @relation(fields: [actorAccountId], references: [id])
  action            AuditAction
  datasetName       String
  recordId          String?
  fieldName         String?
  oldValueMasked    String?
  newValueMasked    String?
  reason            String?
  sessionOrDeviceId String?

  @@index([datasetName, eventAt])
  @@index([actorAccountId])
  @@index([eventAt])
  @@index([action, eventAt])
}

model ImportBatch {
  id                  String       @id @default(cuid())
  importType          String
  uploadedByAccountId String
  uploadedByAccount   Account      @relation(fields: [uploadedByAccountId], references: [id])
  sourceFileName      String
  uploadedAt          DateTime     @default(now())
  totalRows           Int
  validRows           Int
  errorRows           Int
  importStatus        ImportStatus @default(UPLOADED)
  previewConfirmedAt  DateTime?
  postedAt            DateTime?
  // When the current POSTING run started; a run older than a few minutes is
  // treated as dead (e.g. the server timed out) and may be resumed.
  postingStartedAt    DateTime?

  rows ImportRow[]
}

model ImportRow {
  id              String      @id @default(cuid())
  importBatchId   String
  importBatch     ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  rowNumber       Int
  rawData         String
  isValid         Boolean
  rejectionReason String?
  // CTL-13: generalized from the Phase 0 Employee-only import — every
  // dataset's importer sets this once its row is committed, whether that
  // created a brand-new record or updated an existing one (matched by the
  // dataset's natural key).
  rowAction       String?
  createdRecordId String?

  @@index([importBatchId])
}

model FileObject {
  id                  String      @id @default(cuid())
  storageKey          String      @unique
  originalFileName    String
  mimeType            String
  sizeBytes           Int
  sensitivity         Sensitivity @default(RESTRICTED)
  employeeId          String?
  employee            Employee?   @relation(fields: [employeeId], references: [id])
  uploadedByAccountId String
  uploadedByAccount   Account     @relation(fields: [uploadedByAccountId], references: [id])
  category            String?
  issueDate           DateTime?
  expiryDate          DateTime?
  confidential        Boolean     @default(true)
  createdAt           DateTime    @default(now())

  employeeBpjsTkOf                       Employee?             @relation("EmployeeBpjsTkFile")
  employeeBpjsKesehatanOf                Employee?             @relation("EmployeeBpjsKesehatanFile")
  absenceRequestAttachmentOf             AbsenceRequest?       @relation("AbsenceRequestAttachment")
  courseMaterialOf                       CourseMaterial?       @relation("CourseMaterialFile")
  learningAssignmentCertificateOf        LearningAssignment?   @relation("LearningAssignmentCertificateFile")
  learningAssignmentAttendanceEvidenceOf LearningAssignment?   @relation("LearningAssignmentAttendanceEvidenceFile")
  assetCustodyHandoverEvidenceOf         AssetCustody?         @relation("AssetCustodyHandoverEvidence")
  assetCustodyReturnEvidenceOf           AssetCustody?         @relation("AssetCustodyReturnEvidence")
  gaRequestEvidenceOf                    GaRequest?            @relation("GaRequestEvidence")
  maintenanceWorkOrderEvidenceOf         MaintenanceWorkOrder? @relation("MaintenanceWorkOrderEvidence")
  disposalCaseProposalEvidenceOf         DisposalCase?         @relation("DisposalCaseProposalEvidence")
  disposalCaseExecutionEvidenceOf        DisposalCase?         @relation("DisposalCaseExecutionEvidence")

  @@index([employeeId])
}

// ---------- Phase 2 Extension: Attendance & Absence ----------

// HR-Admin-managed master data: a named site with a center point + radius,
// used for the Mobile check-in/out within-radius check.
model AttendanceGeofence {
  id           String   @id @default(cuid())
  siteName     String   @unique
  latitude     Float
  longitude    Float
  radiusMeters Int
  activeFlag   Boolean  @default(true)
  createdAt    DateTime @default(now())

  attendanceAssignments AttendanceAssignment[]
  attendanceEvents      AttendanceEvent[]
}

// Effective-dated, mirrors the Assignment/ShiftAssignment engines: which
// capture Method (+ Geofence, only meaningful for MOBILE) an employee is
// under over time. HR Admin only. There is no per-employee work schedule —
// every employee shares the one fixed company default in lib/attendance.ts.
model AttendanceAssignment {
  id                      String              @id @default(cuid())
  employeeId              String
  employee                Employee            @relation("AttendanceAssignmentEmployee", fields: [employeeId], references: [id])
  method                  AttendanceMethod
  geofenceId              String?
  geofence                AttendanceGeofence? @relation(fields: [geofenceId], references: [id])
  // External device/badge identifier used to match a Fingerprint import row
  // to this employee — only relevant when method = FINGERPRINT. For a
  // machine whose export has no numeric ID column (just a display name),
  // this holds that exact name string instead — fingerprint-attendance.ts
  // auto-detects which export shape it's reading.
  fingerprintDeviceUserId String?
  effectiveFrom           DateTime
  effectiveTo             DateTime?
  assignedAt              DateTime            @default(now())
  assignedByAccountId     String
  assignedByAccount       Account             @relation("AttendanceAssignmentAssignedBy", fields: [assignedByAccountId], references: [id])
  createdAt               DateTime            @default(now())

  attendanceEvents AttendanceEvent[]

  @@index([employeeId, effectiveTo])
}

// A single check-in or check-out punch, from either source. Geofence
// within-radius and lateness are never stored here — they're derived live
// from this event + the linked Geofence, consistent with this app's
// "derive, don't store" convention (deriveEmployeeLifecycleStatus etc).
model AttendanceEvent {
  id                     String                @id @default(cuid())
  employeeId             String
  employee               Employee              @relation("AttendanceEventEmployee", fields: [employeeId], references: [id])
  attendanceAssignmentId String?
  attendanceAssignment   AttendanceAssignment? @relation(fields: [attendanceAssignmentId], references: [id])
  eventType              AttendanceEventType
  eventSource            AttendanceSource
  eventAt                DateTime
  latitude               Float?
  longitude              Float?
  geofenceId             String?
  geofence               AttendanceGeofence?   @relation(fields: [geofenceId], references: [id])
  // Version after UAT: photo requirement dropped (location only). Required
  // whenever the check-in is late or outside every active geofence — see
  // recordAttendanceEvent — otherwise freely optional.
  reason                 String?
  // Result of isLateCheckIn/isEventWithinAnyGeofence at the moment this
  // event was recorded, persisted so HR can review it later (previously
  // computed only to force the `reason` field above, then discarded) — see
  // the "Catatan Terlambat & Di Luar Lokasi" list on Rekonsiliasi Absensi.
  // Only ever set for eventSource MOBILE; a FINGERPRINT_IMPORT event has no
  // coordinates to evaluate and is backfilled with no reason to show anyway.
  late                   Boolean               @default(false)
  withinGeofence         Boolean?
  createdAt              DateTime              @default(now())

  dailyRecordsAsCheckIn  DailyAttendanceRecord[] @relation("DailyRecordCheckInEvent")
  dailyRecordsAsCheckOut DailyAttendanceRecord[] @relation("DailyRecordCheckOutEvent")

  @@index([employeeId, eventAt])
  @@index([eventSource, eventAt])
  @@index([attendanceAssignmentId])
}

// One row per employee per calendar day, produced by the idempotent daily
// reconciliation trigger (mirrors triggerDueRenewalCases()). Exceptions
// (missing punch, late, outside geofence) are deliberately NOT columns here
// — they're computed live from the linked events by lib/attendance.ts's
// fixed default schedule, so this table is purely a "day swept" marker.
model DailyAttendanceRecord {
  id              String           @id @default(cuid())
  employeeId      String
  employee        Employee         @relation("DailyAttendanceRecordEmployee", fields: [employeeId], references: [id])
  attendanceDate  DateTime
  checkInEventId  String?          @unique
  checkInEvent    AttendanceEvent? @relation("DailyRecordCheckInEvent", fields: [checkInEventId], references: [id])
  checkOutEventId String?          @unique
  checkOutEvent   AttendanceEvent? @relation("DailyRecordCheckOutEvent", fields: [checkOutEventId], references: [id])
  reconciledAt    DateTime         @default(now())

  // Rekonsiliasi Absensi, per direct request: HR's day-level classification
  // when a day isn't explained by punches or an approved Absence request
  // alone (Opsi A — the exception queue). Also the same field Opsi B's
  // full-grid "check & override" view writes to when correcting an
  // already-explained day — always carries who/when it was set, never a
  // second set of actor fields (same "in-place overwrite with mandatory
  // identity/timestamp" convention as AbsenceRequest's HR override).
  absenceTypeCode       String?
  absenceType           AbsenceTypeConfig?   @relation(fields: [absenceTypeCode], references: [code])
  shiftType             ShiftAssignmentType?
  classificationNote    String?
  classifiedAt          DateTime?
  classifiedByAccountId String?
  classifiedByAccount   Account?             @relation("DailyAttendanceRecordClassifiedBy", fields: [classifiedByAccountId], references: [id])

  // "Masuk (Lupa Absen)" override, per direct request: a day with no punch
  // is often just a forgotten scan, not a real absence — HR marks it
  // present directly (no absenceTypeCode) and it counts full shift hours,
  // same as a genuine check-in/check-out day.
  presentOverride Boolean @default(false)

  @@unique([employeeId, attendanceDate])
  @@index([attendanceDate])
}

// HR-Admin-configured approver Position per OrgUnit — any tier (Department,
// Section, Group, or Team) can have its own row, deliberately separate from
// the Dept-Head-3B-derived-from-jobLevel pattern used elsewhere, because
// the spec calls for an explicitly configured Position, not a derived one.
//
// Per direct correction: whether an employee's chain has 1 or 2 stages is
// an explicit per-unit choice (`requiresSecondStage`), NOT an automatic
// consequence of how many ancestor tiers happen to have their own row. A
// Department needs its own row regardless — some employees sit directly on
// it, with no Section/Group/Team beneath them at all — so a Section using
// that same Department's row as ITS single stage must not be forced into 2
// stages just because the Department also has a row (which exists for
// those other, direct-to-Department employees' sake, not for this
// Section's escalation). `requiresSecondStage=true` is what opts a
// specific unit's chain into continuing up to the next configured
// ancestor above it; false (the default) stops at this unit's own
// approver. See resolveAbsenceApprovalChain (absence-routing.ts).
model AbsenceApproverConfig {
  id                  String   @id @default(cuid())
  orgUnitId           String   @unique
  orgUnit             OrgUnit  @relation(fields: [orgUnitId], references: [id])
  approverPositionId  String
  approverPosition    Position @relation("AbsenceApproverPosition", fields: [approverPositionId], references: [id])
  requiresSecondStage Boolean  @default(false)
  updatedAt           DateTime @updatedAt
  @@index([approverPositionId])
}

// HR-Admin-configured annual entitlement (days/year) per Absence type.
model AbsenceEntitlementConfig {
  id              String            @id @default(cuid())
  absenceTypeCode String            @unique
  absenceType     AbsenceTypeConfig @relation(fields: [absenceTypeCode], references: [code])
  annualDays      Int
  updatedAt       DateTime          @updatedAt
}

model AbsenceRequest {
  id               String            @id @default(cuid())
  requestNumber    String            @unique
  employeeId       String
  employee         Employee          @relation("AbsenceRequestEmployee", fields: [employeeId], references: [id])
  absenceTypeCode  String
  absenceType      AbsenceTypeConfig @relation(fields: [absenceTypeCode], references: [code])
  startDate        DateTime
  endDate          DateTime
  reason           String
  attachmentFileId String?           @unique
  attachmentFile   FileObject?       @relation("AbsenceRequestAttachment", fields: [attachmentFileId], references: [id])
  status           AbsenceStatus     @default(SUBMITTED)

  submittedAt          DateTime @default(now())
  submittedByAccountId String
  submittedByAccount   Account  @relation("AbsenceRequestSubmittedBy", fields: [submittedByAccountId], references: [id])

  // First-approval stage: whichever Position was configured for the
  // employee's nearest Section or Department (AbsenceApproverConfig) at
  // submission time — see resolveAbsenceApprovalChain (absence-routing.ts).
  firstApproverPositionId  String?
  firstApproverPosition    Position? @relation("AbsenceFirstApproverPosition", fields: [firstApproverPositionId], references: [id])
  firstDecisionAt          DateTime?
  firstDecisionByAccountId String?
  firstDecisionByAccount   Account?  @relation("AbsenceFirstDecisionBy", fields: [firstDecisionByAccountId], references: [id])
  firstDecisionNote        String?

  // Second-approval stage: only set when the resolved first-stage
  // AbsenceApproverConfig row had requiresSecondStage=true AND a further
  // ancestor OrgUnit above it also had its own row at submission time —
  // otherwise null, and the chain stays the original single
  // first-approver-then-HR-Admin shape. Same column pattern as the first
  // stage, deliberately not a generalized N-step table since the chain is
  // capped at 2 configurable stages before the fixed HR Admin one, by
  // direct spec.
  secondApproverPositionId  String?
  secondApproverPosition    Position? @relation("AbsenceSecondApproverPosition", fields: [secondApproverPositionId], references: [id])
  secondDecisionAt          DateTime?
  secondDecisionByAccountId String?
  secondDecisionByAccount   Account?  @relation("AbsenceSecondDecisionBy", fields: [secondDecisionByAccountId], references: [id])
  secondDecisionNote        String?

  hrAdminDecisionAt          DateTime?
  hrAdminDecisionByAccountId String?
  hrAdminDecisionByAccount   Account?  @relation("AbsenceHrAdminDecisionBy", fields: [hrAdminDecisionByAccountId], references: [id])
  hrAdminDecisionNote        String?

  // HR Admin override: in-place overwrite of an already-decided request per
  // spec ("no separate correction record") — always carries a mandatory
  // reason/identity/timestamp when used.
  isHrOverride          Boolean   @default(false)
  hrOverrideReason      String?
  hrOverrideAt          DateTime?
  hrOverrideByAccountId String?
  hrOverrideByAccount   Account?  @relation("AbsenceHrOverrideBy", fields: [hrOverrideByAccountId], references: [id])

  cancelledAt          DateTime?
  cancelledByAccountId String?
  cancelledByAccount   Account?  @relation("AbsenceCancelledBy", fields: [cancelledByAccountId], references: [id])
  cancellationReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@index([status, startDate])
  @@index([absenceTypeCode])
}

// HR-Admin-set per-employee exception to AbsenceEntitlementConfig's
// company-wide default annual quota for one Absence type — e.g. raising one
// employee's Cuti allowance above the default. Absent for an
// (employee, type) pair means "follow the company default"; there is no
// separate "unlimited override" value, since AbsenceEntitlementConfig's own
// 0/unset already means unlimited.
model AbsenceQuotaOverride {
  id                 String            @id @default(cuid())
  employeeId         String
  employee           Employee          @relation("AbsenceQuotaOverrideEmployee", fields: [employeeId], references: [id])
  absenceTypeCode    String
  absenceType        AbsenceTypeConfig @relation(fields: [absenceTypeCode], references: [code])
  annualDays         Int
  updatedAt          DateTime          @updatedAt
  updatedByAccountId String
  updatedByAccount   Account           @relation("AbsenceQuotaOverrideUpdatedBy", fields: [updatedByAccountId], references: [id])

  @@unique([employeeId, absenceTypeCode])
}

// ---------- Task Force membership (new, per direct user request) ----------

// A lightweight, cross-department "also does this" tag — deliberately NOT a
// Position/Assignment: a task force (e.g. Internal Audit) has no org-chart
// placement, no reports-to line, and no jobLevel, so modeling it as a real
// Position risked it accidentally being picked up by dept-head.ts/level3-
// scope.ts's authority checks (which scan ACTIVE Assignments by
// Position.jobLevel/orgUnitId). `name` is deliberately free text rather than
// a separate admin-managed catalog — the UI offers a datalist of previously
// used names for consistency, but doesn't force a config step before first
// use, per direct user request ("don't need it in Struktur Organisasi,
// anything easier").
// ---------- Phase 3A: Competency & Training Operations ----------
// Assessed twice yearly against the Employee's Primary Position only.
// Company Values are universal (same five, 20% each) for every eligible
// Employee. Competency Achievement % and Company Values Score are kept
// separate — no combined performance score in Phase 3A (COM-16).

enum CompetencyCategory {
  GENERAL
  WORK
  LEADERSHIP
}

enum FrameworkStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CycleStatus {
  OPEN
  CLOSED
}

enum EvaluatorSlot {
  P1
  P2
}

enum TrainingRequesterType {
  SELF
  LEVEL_3
}

enum TrainingRequestStatus {
  SUBMITTED
  DEPT_HEAD_APPROVED
  REJECTED
  VALIDATED
  SCHEDULED
  CANCELLED
}

enum TrainingSessionStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum LearningAssignmentSourceType {
  TRAINING_REQUEST
  MANDATORY_RULE
}

enum LearningAssignmentStatus {
  ASSIGNED
  ATTENDED
  COMPLETED
  CANCELLED
}

enum EffectivenessResult {
  EFFECTIVE
  NOT_EFFECTIVE
}

enum MandatoryTargetType {
  EMPLOYEE
  DEPARTMENT
  JOB
  PRIMARY_POSITION
  EVERYONE
}

// ---------- Phase 3B: Learning Library / LMS ----------

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseDeliveryMode {
  ONLINE
  IN_PERSON
  BLENDED
}

enum CourseMaterialType {
  PDF
  DOCX
  PPTX
  VIDEO
  URL
}

enum QuizQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

// Versioned so a later master-data edit never rewrites a completed cycle's
// results (COM-17) — each cycle snapshots the version in use at open time.
model CompetencyFrameworkVersion {
  id              String          @id @default(cuid())
  versionLabel    String
  sourceDocNumber String?
  sourceDocDate   DateTime?
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  status          FrameworkStatus @default(ACTIVE)
  createdAt       DateTime        @default(now())

  definitions CompetencyDefinition[]
  cycles      CompetencyAssessmentCycle[] @relation("CycleCompetencyFramework")
}

// Normalized from LI- General / LI- Work / LI-Leadership (not the broken
// "List" helper tab) per COM-18 — stable `code`, with `aliasesCsv` recording
// known source spelling variants (Innitiavite/Initiative, Adaptibility/
// Adaptability, Troubleshooting/TPM variants) for the historical migration's
// alias resolution, never re-imported live.
model CompetencyDefinition {
  id                 String                     @id @default(cuid())
  frameworkVersionId String
  frameworkVersion   CompetencyFrameworkVersion @relation(fields: [frameworkVersionId], references: [id])
  code               String
  category           CompetencyCategory
  subcategory        String
  name               String
  description        String?
  aliasesCsv         String?
  activeFlag         Boolean                    @default(true)
  displayOrder       Int                        @default(0)

  levelIndicators CompetencyLevelIndicator[]
  requirements    PositionCompetencyRequirement[]
  assessmentItems CompetencyAssessmentItem[]

  @@unique([frameworkVersionId, code])
}

model CompetencyLevelIndicator {
  id                     String               @id @default(cuid())
  competencyDefinitionId String
  competencyDefinition   CompetencyDefinition @relation(fields: [competencyDefinitionId], references: [id])
  level                  Int
  indicatorText          String

  @@unique([competencyDefinitionId, level])
}

model CompanyValueFrameworkVersion {
  id              String          @id @default(cuid())
  versionLabel    String
  sourceDocNumber String?
  sourceDocDate   DateTime?
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  status          FrameworkStatus @default(ACTIVE)
  createdAt       DateTime        @default(now())

  definitions CompanyValueDefinition[]
  cycles      CompetencyAssessmentCycle[] @relation("CycleCompanyValueFramework")
}

// Exactly five values from the Tata Nilai source, each weighted 20%
// (COM-14) — every eligible Employee in a cycle gets the identical set.
model CompanyValueDefinition {
  id                 String                       @id @default(cuid())
  frameworkVersionId String
  frameworkVersion   CompanyValueFrameworkVersion @relation(fields: [frameworkVersionId], references: [id])
  code               String
  name               String
  weight             Int                          @default(20)
  displayOrder       Int                          @default(0)

  rubricIndicators CompanyValueRubricIndicator[]
  assessmentItems  CompanyValueAssessmentItem[]

  @@unique([frameworkVersionId, code])
}

model CompanyValueRubricIndicator {
  id                       String                 @id @default(cuid())
  companyValueDefinitionId String
  companyValueDefinition   CompanyValueDefinition @relation(fields: [companyValueDefinitionId], references: [id])
  score                    Int
  indicatorText            String

  @@unique([companyValueDefinitionId, score])
}

// Admin-configured per Job (not per individual Position seat — a documented
// simplification of COM-05's "per Position or inherited from Job with
// Position-specific override": every real seat for a Job shares the same
// requirement in this build). `isRequired=false` is the sole N/A
// representation — target level 0 is never overloaded to also mean N/A
// (DM-43).
model PositionCompetencyRequirement {
  id                     String               @id @default(cuid())
  jobId                  String
  job                    Job                  @relation(fields: [jobId], references: [id])
  competencyDefinitionId String
  competencyDefinition   CompetencyDefinition @relation(fields: [competencyDefinitionId], references: [id])
  isRequired             Boolean              @default(true)
  targetLevel            Int?
  updatedByAccountId     String
  updatedByAccount       Account              @relation("PositionCompetencyRequirementUpdatedBy", fields: [updatedByAccountId], references: [id])
  updatedAt              DateTime             @updatedAt
  createdAt              DateTime             @default(now())

  @@unique([jobId, competencyDefinitionId])
}

// Opened by Training Admin (COM-06); snapshots active Employees, Primary
// Position and both framework versions at open time — never recomputed
// live afterward.
model CompetencyAssessmentCycle {
  id                             String                       @id @default(cuid())
  cycleCode                      String                       @unique
  periodLabel                    String
  cutoffDate                     DateTime
  startDate                      DateTime
  endDate                        DateTime?
  competencyFrameworkVersionId   String
  competencyFrameworkVersion     CompetencyFrameworkVersion   @relation("CycleCompetencyFramework", fields: [competencyFrameworkVersionId], references: [id])
  companyValueFrameworkVersionId String
  companyValueFrameworkVersion   CompanyValueFrameworkVersion @relation("CycleCompanyValueFramework", fields: [companyValueFrameworkVersionId], references: [id])
  status                         CycleStatus                  @default(OPEN)
  // One-time historical migration batches are modeled as their own closed,
  // read-only cycles (COM-19) — reuses every downstream gap/report/display
  // path rather than a parallel schema, and keeps them clearly out of the
  // routine twice-yearly cadence.
  isHistorical                   Boolean                      @default(false)
  openedByAccountId              String
  openedByAccount                Account                      @relation("CycleOpenedBy", fields: [openedByAccountId], references: [id])
  openedAt                       DateTime                     @default(now())
  closedAt                       DateTime?

  assessments CompetencyAssessment[]
}

// One row per eligible Employee per cycle. P1/P2 routing per ACC-21/COM-15:
// normal Employee P1=Primary-Position supervisor, P2=Department Head;
// Level-3 Employee P1=Director, P2=HR Manager. HR Admin may reassign either
// slot (see CompetencyEvaluatorChange) but never scores unless separately
// assigned as P1/P2 themselves.
model CompetencyAssessment {
  id                  String                    @id @default(cuid())
  cycleId             String
  cycle               CompetencyAssessmentCycle @relation(fields: [cycleId], references: [id])
  employeeId          String
  employee            Employee                  @relation("CompetencyAssessmentEmployee", fields: [employeeId], references: [id])
  primaryAssignmentId String?
  primaryAssignment   Assignment?               @relation(fields: [primaryAssignmentId], references: [id])
  positionId          String?
  position            Position?                 @relation("CompetencyAssessmentPosition", fields: [positionId], references: [id])
  jobId               String?
  job                 Job?                      @relation("CompetencyAssessmentJob", fields: [jobId], references: [id])
  orgUnitId           String?
  orgUnit             OrgUnit?                  @relation(fields: [orgUnitId], references: [id])
  isLevel3AtSnapshot  Boolean                   @default(false)

  p1EmployeeId String?
  p1Employee   Employee? @relation("CompetencyAssessmentP1", fields: [p1EmployeeId], references: [id])
  p1PositionId String?
  p1Position   Position? @relation("CompetencyAssessmentP1Position", fields: [p1PositionId], references: [id])
  p2EmployeeId String?
  p2Employee   Employee? @relation("CompetencyAssessmentP2", fields: [p2EmployeeId], references: [id])
  p2PositionId String?
  p2Position   Position? @relation("CompetencyAssessmentP2Position", fields: [p2PositionId], references: [id])

  p1SubmittedAt            DateTime?
  p2SubmittedAt            DateTime?
  // Null until both required submissions are complete — always derived from
  // the Items at that moment via lib/competency.ts, never recomputed later
  // by a master-data edit (COM-17).
  competencyAchievementPct Float?
  companyValuesScore       Float?
  completedAt              DateTime?

  // True only for a row created by the one-time historical migration
  // (COM-19) — read-only, no Company Values items, no P1/P2 tasks.
  isHistoricalMigration Boolean @default(false)

  createdAt DateTime @default(now())

  items            CompetencyAssessmentItem[]
  valueItems       CompanyValueAssessmentItem[]
  evaluatorChanges CompetencyEvaluatorChange[]

  @@unique([cycleId, employeeId])
  @@index([employeeId])
  @@index([p1EmployeeId])
  @@index([p2EmployeeId])
  @@index([positionId])
}

// Mandatory-reason, full-audit-trail HR Admin reassignment of P1 or P2
// (COM-15/ACC-21). Reassigning an already-submitted slot voids/reopens only
// that slot for a fresh submission — handled in the action, not the schema.
model CompetencyEvaluatorChange {
  id                 String               @id @default(cuid())
  assessmentId       String
  assessment         CompetencyAssessment @relation(fields: [assessmentId], references: [id])
  slot               EvaluatorSlot
  oldEmployeeId      String?
  oldEmployee        Employee?            @relation("CompetencyEvaluatorChangeOld", fields: [oldEmployeeId], references: [id])
  newEmployeeId      String
  newEmployee        Employee             @relation("CompetencyEvaluatorChangeNew", fields: [newEmployeeId], references: [id])
  reason             String
  changedByAccountId String
  changedByAccount   Account              @relation("CompetencyEvaluatorChangeBy", fields: [changedByAccountId], references: [id])
  changedAt          DateTime             @default(now())
  @@index([assessmentId])
}

// Snapshotted at cycle-open from PositionCompetencyRequirement so a later
// requirement edit never changes an already-open or completed assessment
// (COM-17). `actualLevel` stays null until P1 submits; 0 explicitly means
// "below Level 1 / not yet demonstrated" per COM-04, distinct from null
// (not yet assessed) and from `isRequired=false` (N/A).
model CompetencyAssessmentItem {
  id                     String               @id @default(cuid())
  assessmentId           String
  assessment             CompetencyAssessment @relation(fields: [assessmentId], references: [id])
  competencyDefinitionId String
  competencyDefinition   CompetencyDefinition @relation(fields: [competencyDefinitionId], references: [id])
  competencyNameSnapshot String
  categorySnapshot       CompetencyCategory
  isRequired             Boolean
  requiredLevel          Int?
  actualLevel            Int?
  comment                String?

  @@unique([assessmentId, competencyDefinitionId])
  @@index([competencyDefinitionId])
}

// Per-value result = average(P1,P2) × weight/100, summed for the Company
// Values Score (COM-14/DM-46) — computed live in lib/competency.ts, never
// stored. P1 and P2 score independently; neither can see the other's score
// while entering their own (enforced at the page level).
model CompanyValueAssessmentItem {
  id                       String                 @id @default(cuid())
  assessmentId             String
  assessment               CompetencyAssessment   @relation(fields: [assessmentId], references: [id])
  companyValueDefinitionId String
  companyValueDefinition   CompanyValueDefinition @relation(fields: [companyValueDefinitionId], references: [id])
  valueNameSnapshot        String
  weightSnapshot           Int
  p1Score                  Int?
  p1Comment                String?
  p2Score                  Int?
  p2Comment                String?

  @@unique([assessmentId, companyValueDefinitionId])
  @@index([companyValueDefinitionId])
}

// Manually created by Training Admin (TRN-11) — creation alone enrolls no
// one; a LearningAssignment still requires an approved TrainingRequest or
// an active MandatoryTrainingRule (COM-11/TRN-09).
model TrainingCourse {
  id                        String             @id @default(cuid())
  title                     String
  category                  String?
  provider                  String?
  deliveryMethod            String?
  // Phase 3B: structured delivery mode drives completion-rule branching
  // (ONLINE: materials+quiz; IN_PERSON: attendance; BLENDED: both) — kept
  // separate from the free-text `deliveryMethod` above (e.g. "Zoom" vs a
  // physical location), which is still just descriptive detail.
  mode                      CourseDeliveryMode @default(ONLINE)
  objectives                String?
  // TRN-12/ACC-23: authoring lifecycle. `activeFlag` (below) predates this
  // and is left in place rather than removed — every Phase 3A consumer that
  // filters courses now checks `status: PUBLISHED` instead; `activeFlag`
  // itself is no longer read anywhere new.
  status                    CourseStatus       @default(DRAFT)
  // Marks this course as one of the "compulsory for onboarding" set — any
  // active MandatoryTrainingRule pointing at an isOnboardingRequired course
  // is auto-applied to a brand-new Employee the moment they're created
  // (see lib/mandatory-training.ts's applyOnboardingMandatoryTrainingForEmployee),
  // in addition to the normal manual Terapkan flow every other Mandatory
  // Rule still uses.
  isOnboardingRequired      Boolean            @default(false)
  plannedCost               Float?
  certificateRequired       Boolean            @default(false)
  effectivenessRequired     Boolean            @default(false)
  effectivenessFollowupDays Int                @default(30)
  activeFlag                Boolean            @default(true)
  createdByAccountId        String
  createdByAccount          Account            @relation("TrainingCourseCreatedBy", fields: [createdByAccountId], references: [id])
  createdAt                 DateTime           @default(now())

  sessions            TrainingSession[]
  requests            TrainingRequest[]
  learningAssignments LearningAssignment[]
  mandatoryRules      MandatoryTrainingRule[]
  materials           CourseMaterial[]
  quiz                Quiz?
}

model TrainingSession {
  id                 String                @id @default(cuid())
  courseId           String
  course             TrainingCourse        @relation(fields: [courseId], references: [id])
  startDate          DateTime
  endDate            DateTime?
  location           String?
  capacity           Int?
  status             TrainingSessionStatus @default(PLANNED)
  createdByAccountId String
  createdByAccount   Account               @relation("TrainingSessionCreatedBy", fields: [createdByAccountId], references: [id])
  createdAt          DateTime              @default(now())

  requests            TrainingRequest[]
  learningAssignments LearningAssignment[]
  @@index([courseId])
}

// Employee self-request or a Level-3 Position requesting for its own
// Department (TRN-09) — a gap reference is informative only and never
// auto-creates a request (COM-11/TRN-02).
model TrainingRequest {
  id                    String                @id @default(cuid())
  requestNumber         String                @unique
  requesterType         TrainingRequesterType
  employeeId            String
  employee              Employee              @relation("TrainingRequestEmployee", fields: [employeeId], references: [id])
  submittedByAccountId  String
  submittedByAccount    Account               @relation("TrainingRequestSubmittedBy", fields: [submittedByAccountId], references: [id])
  departmentIdSnapshot  String?
  departmentSnapshot    OrgUnit?              @relation(fields: [departmentIdSnapshot], references: [id])
  positionIdSnapshot    String?
  positionSnapshot      Position?             @relation("TrainingRequestPositionSnapshot", fields: [positionIdSnapshot], references: [id])
  reason                String
  gapReferenceNote      String?
  requestedTopic        String
  businessJustification String?
  preferredTiming       String?
  status                TrainingRequestStatus @default(SUBMITTED)

  deptHeadDecisionAt          DateTime?
  deptHeadDecisionByAccountId String?
  deptHeadDecisionByAccount   Account?  @relation("TrainingRequestDeptHeadDecisionBy", fields: [deptHeadDecisionByAccountId], references: [id])
  deptHeadDecisionPositionId  String?
  deptHeadDecisionPosition    Position? @relation("TrainingRequestDeptHeadDecisionPosition", fields: [deptHeadDecisionPositionId], references: [id])
  deptHeadNote                String?

  trainingAdminDecisionAt          DateTime?
  trainingAdminDecisionByAccountId String?
  trainingAdminDecisionByAccount   Account?  @relation("TrainingRequestTrainingAdminDecisionBy", fields: [trainingAdminDecisionByAccountId], references: [id])
  trainingAdminNote                String?

  courseId  String?
  course    TrainingCourse?  @relation(fields: [courseId], references: [id])
  sessionId String?
  session   TrainingSession? @relation(fields: [sessionId], references: [id])

  cancelledAt          DateTime?
  cancelledByAccountId String?
  cancelledByAccount   Account?  @relation("TrainingRequestCancelledBy", fields: [cancelledByAccountId], references: [id])
  cancellationReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  learningAssignment LearningAssignment?

  @@index([employeeId])
  @@index([status])
  @@index([courseId])
  @@index([sessionId])
}

// Created only from an approved TrainingRequest or an active
// MandatoryTrainingRule (COM-11/TRN-09) — never from a competency gap.
model LearningAssignment {
  id                            String                       @id @default(cuid())
  employeeId                    String
  employee                      Employee                     @relation("LearningAssignmentEmployee", fields: [employeeId], references: [id])
  courseId                      String
  course                        TrainingCourse               @relation(fields: [courseId], references: [id])
  sessionId                     String?
  session                       TrainingSession?             @relation(fields: [sessionId], references: [id])
  sourceType                    LearningAssignmentSourceType
  sourceTrainingRequestId       String?                      @unique
  sourceTrainingRequest         TrainingRequest?             @relation(fields: [sourceTrainingRequestId], references: [id])
  sourceMandatoryRuleId         String?
  sourceMandatoryRule           MandatoryTrainingRule?       @relation(fields: [sourceMandatoryRuleId], references: [id])
  assignedByAccountId           String
  assignedByAccount             Account                      @relation("LearningAssignmentAssignedBy", fields: [assignedByAccountId], references: [id])
  assignedAt                    DateTime                     @default(now())
  status                        LearningAssignmentStatus     @default(ASSIGNED)
  attendanceConfirmedAt         DateTime?
  completedAt                   DateTime?
  certificateNumber             String?
  certificateIssueDate          DateTime?
  // Per-course, not per-assignment (TRN-04) — snapshotted here so a later
  // course edit never changes an already-assigned learner's obligation.
  effectivenessRequiredSnapshot Boolean                      @default(false)
  effectivenessDueDate          DateTime?
  effectivenessCompletedAt      DateTime?
  effectivenessResult           EffectivenessResult?
  effectivenessEvaluatorId      String?
  effectivenessEvaluator        Employee?                    @relation("LearningAssignmentEffectivenessEvaluator", fields: [effectivenessEvaluatorId], references: [id])
  effectivenessEvidence         String?
  createdAt                     DateTime                     @default(now())

  // Phase 3B additions below — certificate expiry/upload, in-person
  // attendance evidence, quiz-retry bonus, and the mandatory-reason text for
  // an explicit refresher override (duplicate-active-assignment exception).
  certificateExpiryDate    DateTime?
  certificateFileId        String?     @unique
  certificateFile          FileObject? @relation("LearningAssignmentCertificateFile", fields: [certificateFileId], references: [id])
  attendanceEvidenceNote   String?
  attendanceEvidenceFileId String?     @unique
  attendanceEvidenceFile   FileObject? @relation("LearningAssignmentAttendanceEvidenceFile", fields: [attendanceEvidenceFileId], references: [id])
  // Incremented only via the audited quiz-attempt-reset action (TRN-14) —
  // canRetryQuiz() checks attempt count against quiz.maxAttempts PLUS this,
  // so a reset never mutates historical QuizAttempt rows.
  quizBonusAttempts        Int         @default(0)
  // Set only when this row was created as an explicit Training-Admin-
  // confirmed refresher despite an existing active assignment for the same
  // (employee, course) — the ordinary path leaves this null.
  overrideReason           String?

  materialProgress LearningAssignmentMaterialProgress[]
  quizAttempts     QuizAttempt[]

  @@index([employeeId, status])
  @@index([courseId, status])
  @@index([status, effectivenessRequiredSnapshot, effectivenessCompletedAt])
  @@index([sessionId])
}

// Exactly five target types (TRN-13/DM-41): Employee, Department, Job,
// Primary Position or Everyone. "Apply" resolves the audience live from
// current organization/Primary Assignment data and idempotently creates one
// LearningAssignment per resolved Employee (never a duplicate active one).
model MandatoryTrainingRule {
  id                 String              @id @default(cuid())
  courseId           String
  course             TrainingCourse      @relation(fields: [courseId], references: [id])
  targetType         MandatoryTargetType
  targetEmployeeId   String?
  targetEmployee     Employee?           @relation("MandatoryTrainingRuleTargetEmployee", fields: [targetEmployeeId], references: [id])
  targetDepartmentId String?
  targetDepartment   OrgUnit?            @relation(fields: [targetDepartmentId], references: [id])
  targetJobId        String?
  targetJob          Job?                @relation(fields: [targetJobId], references: [id])
  targetPositionId   String?
  targetPosition     Position?           @relation("MandatoryTrainingRuleTargetPosition", fields: [targetPositionId], references: [id])
  activeFlag         Boolean             @default(true)
  createdByAccountId String
  createdByAccount   Account             @relation("MandatoryTrainingRuleCreatedBy", fields: [createdByAccountId], references: [id])
  createdAt          DateTime            @default(now())

  learningAssignments LearningAssignment[]
  @@index([courseId])
}

// Ordered content within a Published course (TRN-12) — PDF/DOCX/PPTX are
// file-backed (FileObject, same private-storage pattern as every other
// document in this app); VIDEO/URL are external links. `isRequired=false`
// materials don't gate "all required materials complete" for Online/
// Blended completion but still appear in the course for reference.
model CourseMaterial {
  id           String             @id @default(cuid())
  courseId     String
  course       TrainingCourse     @relation(fields: [courseId], references: [id])
  displayOrder Int                @default(0)
  title        String
  materialType CourseMaterialType
  fileId       String?            @unique
  file         FileObject?        @relation("CourseMaterialFile", fields: [fileId], references: [id])
  externalUrl  String?
  isRequired   Boolean            @default(true)
  createdAt    DateTime           @default(now())

  progress LearningAssignmentMaterialProgress[]
  @@index([courseId])
}

model LearningAssignmentMaterialProgress {
  id                   String             @id @default(cuid())
  learningAssignmentId String
  learningAssignment   LearningAssignment @relation(fields: [learningAssignmentId], references: [id])
  materialId           String
  material             CourseMaterial     @relation(fields: [materialId], references: [id])
  completedAt          DateTime           @default(now())

  @@unique([learningAssignmentId, materialId])
  @@index([materialId])
}

// One Quiz per Course (TRN-12/COM-06 pattern reuse: configured once at
// authoring time, not per-assignment) — `maxAttempts` is the retry limit;
// `passingScorePercent` is compared against a QuizAttempt's computed score.
model Quiz {
  id                  String         @id @default(cuid())
  courseId            String         @unique
  course              TrainingCourse @relation(fields: [courseId], references: [id])
  passingScorePercent Int            @default(70)
  maxAttempts         Int            @default(3)
  createdAt           DateTime       @default(now())

  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id           String           @id @default(cuid())
  quizId       String
  quiz         Quiz             @relation(fields: [quizId], references: [id])
  displayOrder Int              @default(0)
  questionText String
  questionType QuizQuestionType
  points       Int              @default(1)

  options QuizOption[]
  answers QuizAttemptAnswer[]
  @@index([quizId])
}

// TRUE_FALSE is modeled as exactly two options (no separate boolean field) —
// scoring and rendering both reuse the same single/multi-select machinery
// regardless of question type.
model QuizOption {
  id           String       @id @default(cuid())
  questionId   String
  question     QuizQuestion @relation(fields: [questionId], references: [id])
  displayOrder Int          @default(0)
  optionText   String
  isCorrect    Boolean      @default(false)

  selectedIn QuizAttemptAnswer[]
  @@index([questionId])
}

// One row per attempt, scored server-side and never recomputed client-side
// (Key Control: "Server-side quiz scoring"). Retries beyond `Quiz.maxAttempts`
// are only possible via `LearningAssignment.quizBonusAttempts`, itself only
// ever incremented by an audited Training Admin action (Key Control:
// "Audited retry reset") — there is no reset field on this model itself,
// consistent with every other override in this app being tracked through
// AuditLog rather than a duplicated schema field.
model QuizAttempt {
  id                   String             @id @default(cuid())
  learningAssignmentId String
  learningAssignment   LearningAssignment @relation(fields: [learningAssignmentId], references: [id])
  quizId               String
  quiz                 Quiz               @relation(fields: [quizId], references: [id])
  attemptNumber        Int
  startedAt            DateTime           @default(now())
  submittedAt          DateTime?
  scorePercent         Float?
  passed               Boolean?

  answers QuizAttemptAnswer[]

  @@unique([learningAssignmentId, attemptNumber])
  @@index([quizId])
}

// One row per option the learner selected for a question on this attempt —
// naturally supports MULTIPLE_CHOICE as several rows for the same question,
// SINGLE_CHOICE/TRUE_FALSE as exactly one.
model QuizAttemptAnswer {
  id         String       @id @default(cuid())
  attemptId  String
  attempt    QuizAttempt  @relation(fields: [attemptId], references: [id])
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id])
  optionId   String
  option     QuizOption   @relation(fields: [optionId], references: [id])

  @@unique([attemptId, questionId, optionId])
  @@index([questionId])
  @@index([optionId])
}

// ---------- Phase 4A: Employee Assets ----------
// Source: phase_4a_employee_asset_workflow.pdf. GA Admin owns every asset
// record end to end (Access boundary: "HR Admin receives only onboarding/
// offboarding completion or blocker status and cannot create, assign,
// return or edit GA records") — see canManageAssets/canViewAssetMaster in
// permissions.ts, both isGaAdmin-only, deliberately never isHrAdmin.

enum AssetTrackingType {
  INDIVIDUAL
  QUANTITY_TRACKED
}

// Authoritative only for INDIVIDUAL assets (one physical unit). A
// QUANTITY_TRACKED asset's real "how much is left" signal is
// availableQuantity vs totalQuantity below — its own status field stays
// AVAILABLE by convention (a pooled item type doesn't have a single
// instance state). UNDER_REPAIR/DISPOSED were originally Phase 4A-only
// terminal outcomes of a *return inspection* (Phase 4A's own return flow,
// unchanged). Phase 4B adds two more: LOST_PENDING_REVIEW (a Loss GaRequest
// was submitted for this asset, awaiting the configured reviewing
// Position's confirmation) and RETIRED (a DisposalCase actually executed —
// deliberately distinct from Phase 4A's DISPOSED, which stays only the
// immediate "returned in unusable condition" shortcut with no approval
// gate; RETIRED is the Phase 4B formal disposal-with-approval outcome,
// covering retire/dispose/sell-as-scrap alike since this app builds no
// accounting/depreciation distinction between those methods). All four
// non-AVAILABLE statuses block a new INDIVIDUAL assignment — see
// isAssetAvailableForIndividualAssignment in lib/assets.ts, which already
// allowlists only AVAILABLE, so both new values are blocked automatically
// with no change to that Phase 4A function.
enum AssetStatus {
  AVAILABLE
  IN_USE
  UNDER_REPAIR
  DISPOSED
  LOST_PENDING_REVIEW
  RETIRED
  // An open disposal case exists (beyond repair, confirmed loss or obsolete). Blocks placement.
  PENDING_DISPOSAL
}

enum AssetCustodyTargetType {
  EMPLOYEE
  DEPARTMENT
  LOCATION
}

// Per direct user request, custody starts ACTIVE immediately for every
// target type — no employee-acknowledgement step. (The PDF describes an
// acknowledgement gate, but the user explicitly overrode it as unneeded.)
enum AssetCustodyStatus {
  ACTIVE
  RETURNED
}

enum AssetInspectionResult {
  GOOD
  NEEDS_REPAIR
  LOST_OR_BEYOND_REPAIR
}

// No generic "Location" master exists elsewhere in this schema
// (AttendanceGeofence is purpose-built for GPS check-in, not a fit) — new,
// GA-Admin-managed master data, same shape/convention as every other
// admin-owned lookup table (AttendanceGeofence, EducationLevel, etc.).
model AssetLocation {
  id           String   @id @default(cuid())
  locationName String   @unique
  description  String?
  activeFlag   Boolean  @default(true)
  createdAt    DateTime @default(now())

  custodies  AssetCustody[]
  gaRequests GaRequest[]
}

model FixedAsset {
  id                 String            @id @default(cuid())
  assetCode          String            @unique
  assetName          String
  category           String?
  // Free text, all optional: brand/model/type, specification, and the company's own asset number.
  modelBrand         String?
  specification      String?
  assetNumber        String?
  trackingType       AssetTrackingType
  status             AssetStatus       @default(AVAILABLE)
  // Only meaningful for QUANTITY_TRACKED — null for INDIVIDUAL. Reduced
  // permanently (not returned to the pool) when a returned quantity's
  // inspectionResult isn't GOOD, since Phase 4B repair/disposal isn't built
  // yet — a documented simplification, same spirit as every other
  // "next phase not built, don't fake it" note in this app.
  totalQuantity      Int?
  availableQuantity  Int?
  purchaseDate       DateTime?
  purchaseCost       Float?
  notes              String?
  // Retires an asset *type* from the catalog/pickers — distinct from
  // AssetStatus.DISPOSED, which is a single INDIVIDUAL unit's terminal
  // state. Same activeFlag convention as every other master-data model.
  activeFlag         Boolean           @default(true)
  createdByAccountId String
  createdByAccount   Account           @relation("FixedAssetCreatedBy", fields: [createdByAccountId], references: [id])
  createdAt          DateTime          @default(now())

  custodies             AssetCustody[]
  gaRequests            GaRequest[]
  maintenancePlans      MaintenancePlan[]
  maintenanceWorkOrders MaintenanceWorkOrder[]
  disposalCases         DisposalCase[]

  @@index([activeFlag, status])
}

// One row per custody period — a return or transfer always creates a new
// row rather than mutating this one ("Returns and reassignments create
// history; prior records are never overwritten"). Exactly one of
// employeeId/orgUnitId/locationId is set, matching targetType — enforced in
// lib/assets.ts, the same app-layer-invariant convention as every other
// "exactly one of N" rule in this app (Prisma/SQLite has no polymorphic
// association). Since 2026-10-13 new placements are EMPLOYEE or DEPARTMENT only;
// a DEPARTMENT row also carries locationId as the place the asset is at. Old
// LOCATION rows are kept as history.
model AssetCustody {
  id         String                 @id @default(cuid())
  assetId    String
  asset      FixedAsset             @relation(fields: [assetId], references: [id])
  targetType AssetCustodyTargetType
  employeeId String?
  employee   Employee?              @relation("AssetCustodyEmployee", fields: [employeeId], references: [id])
  orgUnitId  String?
  orgUnit    OrgUnit?               @relation(fields: [orgUnitId], references: [id])
  locationId String?
  location   AssetLocation?         @relation(fields: [locationId], references: [id])
  // Always 1 for INDIVIDUAL; the allocated amount (<= availableQuantity at
  // creation time) for QUANTITY_TRACKED.
  quantity   Int                    @default(1)
  status     AssetCustodyStatus     @default(ACTIVE)

  conditionAtHandover    String?
  handoverEvidenceFileId String?     @unique
  handoverEvidenceFile   FileObject? @relation("AssetCustodyHandoverEvidence", fields: [handoverEvidenceFileId], references: [id])
  assignedAt             DateTime    @default(now())
  assignedByAccountId    String
  assignedByAccount      Account     @relation("AssetCustodyAssignedBy", fields: [assignedByAccountId], references: [id])

  returnedAt             DateTime?
  returnedByAccountId    String?
  returnedByAccount      Account?               @relation("AssetCustodyReturnedBy", fields: [returnedByAccountId], references: [id])
  returnConditionNote    String?
  returnEvidenceFileId   String?                @unique
  returnEvidenceFile     FileObject?            @relation("AssetCustodyReturnEvidence", fields: [returnEvidenceFileId], references: [id])
  inspectionResult       AssetInspectionResult?
  // Set only when this row was closed by transferAssetCustody (an atomic
  // return-and-reassign to a new target) rather than a plain return — lets
  // the history view distinguish "handed back to GA" from "moved straight
  // to someone/somewhere else" without losing either record.
  transferredToCustodyId String?                @unique

  createdAt DateTime @default(now())

  @@index([employeeId, status])
  @@index([assetId])
  @@index([status])
  @@index([orgUnitId])
  @@index([locationId])
}

// ── Consumables (APD / ATK) ─────────────────────────────────────────────
// GA-Admin-only quantity ledger, deliberately separate from FixedAsset: a
// consumable is never returned and has no per-unit identity, so there is no
// custody, status lifecycle or approval flow. Current stock and the
// Aman/Menipis/Habis status are NEVER stored — they are derived from
// openingStock + the non-cancelled ledger rows (see lib/consumables.ts).
// Transactions are cancelled, never deleted.

enum ConsumableCategory {
  APD
  ATK
}

enum ConsumableTxType {
  ISSUE
  RECEIPT
  ADJUSTMENT
}

enum ConsumableRecipientType {
  EMPLOYEE
  DEPARTMENT
}

enum ConsumableTxSource {
  APP
  IMPORT
}

model ConsumableItem {
  id                      String             @id @default(cuid())
  // Printed on the QR label, so it never changes once created.
  itemCode                String             @unique
  itemName                String
  category                ConsumableCategory
  unit                    String
  openingStock            Int                @default(0)
  minStock                Int                @default(0)
  // 0 = no replacement-period rule for this item.
  replacementPeriodMonths Int                @default(0)
  // Hides the item from pickers and labels; history and stock stay intact.
  archived                Boolean            @default(false)
  createdByAccountId      String
  createdByAccount        Account            @relation("ConsumableItemCreatedBy", fields: [createdByAccountId], references: [id])
  createdAt               DateTime           @default(now())

  transactions ConsumableTransaction[]

  @@index([category])
}

// One ledger for all three movement types. quantityDelta is signed: ISSUE
// negative, RECEIPT positive, ADJUSTMENT = physical - system at save time.
model ConsumableTransaction {
  id            String             @id @default(cuid())
  itemId        String
  item          ConsumableItem     @relation(fields: [itemId], references: [id])
  type          ConsumableTxType
  quantityDelta Int
  occurredAt    DateTime           @default(now())
  source        ConsumableTxSource @default(APP)

  // ISSUE only. Exactly one of employeeId/orgUnitId is set for an in-app
  // take; an unmatched imported name keeps employeeId null and only the
  // snapshot text. Snapshots keep history readable after transfers/renames.
  recipientType          ConsumableRecipientType?
  employeeId             String?
  employee               Employee?                @relation("ConsumableTxEmployee", fields: [employeeId], references: [id])
  orgUnitId              String?
  orgUnit                OrgUnit?                 @relation("ConsumableTxOrgUnit", fields: [orgUnitId], references: [id])
  recipientNameSnapshot  String?
  departmentNameSnapshot String?
  purpose                String?
  beforePeriod           Boolean                  @default(false)
  exceededStock          Boolean                  @default(false)
  warningReason          String?
  // Groups the lines of one multi-item handover.
  batchId                String?

  // RECEIPT only.
  reference String?
  note      String?

  // ADJUSTMENT only.
  systemStockSnapshot Int?
  physicalStock       Int?
  reason              String?

  recordedByAccountId String
  recordedByAccount   Account  @relation("ConsumableTxRecordedBy", fields: [recordedByAccountId], references: [id])
  // Optional free text: the shared GA Admin account records for several people.
  recordedByLabel     String?
  createdAt           DateTime @default(now())

  cancelledAt          DateTime?
  cancelledByAccountId String?
  cancelledByAccount   Account?  @relation("ConsumableTxCancelledBy", fields: [cancelledByAccountId], references: [id])
  cancelReason         String?

  @@index([itemId, occurredAt])
  @@index([employeeId, itemId, occurredAt])
  @@index([type, occurredAt])
  @@index([batchId])
  @@index([itemId, type, cancelledAt])
}

model TaskForceMembership {
  id               String    @id @default(cuid())
  employeeId       String
  employee         Employee  @relation("TaskForceMember", fields: [employeeId], references: [id])
  name             String
  roleLabel        String?
  startDate        DateTime
  endDate          DateTime?
  addedByAccountId String
  addedByAccount   Account   @relation("TaskForceMembershipAddedBy", fields: [addedByAccountId], references: [id])
  createdAt        DateTime  @default(now())
  @@index([employeeId])
}

// ==================== Phase 4B: GA Operations ====================
// Requests (new asset / damage / loss), preventive/corrective maintenance,
// and Position-approved disposal. Reuses Phase 4A's FixedAsset/AssetCustody/
// AssetLocation and Phase 4A's custody actions for the New Asset Need
// hand-off (see src/app/(app)/ga-requests/actions.ts) rather than
// duplicating custody-creation logic. GA Admin-only mutation surface,
// mirroring Phase 4A's access boundary (HR Admin excluded, see
// [[project_hr_app_cbp_phase4a_employee_assets]] equivalent note in
// docs/DECISIONS.md).

enum GaRequestType {
  NEW_ASSET_NEED
  DAMAGE_OR_ABNORMAL_CONDITION
  LOSS
}

enum GaRequestUrgency {
  LOW
  MEDIUM
  HIGH
}

// One shared status set covers all three request types; which values are
// reachable depends on requestType (enforced in lib/ga-operations.ts, not
// by the schema — same "shared enum, type-gated transitions" shape as
// OffboardingCaseStatus elsewhere in this file).
// NEW_ASSET_NEED: SUBMITTED -> (verify) -> PENDING_APPROVAL or straight to
//   APPROVED -> REJECTED/APPROVED -> PROCESSED.
// DAMAGE_OR_ABNORMAL_CONDITION: SUBMITTED -> (verify) -> WORK_ORDER_CREATED
//   (terminal for the request; the corrective work continues as a
//   MaintenanceWorkOrder).
// LOSS: SUBMITTED -> (verify) -> PENDING_LOSS_REVIEW -> LOSS_CONFIRMED
//   (drafts a DisposalCase) or LOSS_NOT_CONFIRMED (terminal).
// CANCELLED: same DM-25-style withdrawal available on every other
// submittable-request workflow in this app, reachable from any pre-terminal
// status (see canCancelGaRequestStatus in ga-operations.ts).
enum GaRequestStatus {
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PROCESSED
  WORK_ORDER_CREATED
  PENDING_LOSS_REVIEW
  LOSS_CONFIRMED
  LOSS_NOT_CONFIRMED
  CANCELLED
  // A damage request whose work order has been recorded.
  COMPLETED
}

// PDF: "Submit new need, damage, loss or abnormal condition" -> "GA Admin
// verifies asset, location and urgency" -> routes by requestType.
// "Requester sees only own requests" / "HR Admin has no GA operational
// access" are enforced in permissions.ts, not here.
model GaRequest {
  id            String           @id @default(cuid())
  requestNumber String           @unique
  requestType   GaRequestType
  status        GaRequestStatus  @default(SUBMITTED)
  urgency       GaRequestUrgency @default(MEDIUM)
  description   String

  requesterEmployeeId  String
  requester            Employee @relation("GaRequestRequester", fields: [requesterEmployeeId], references: [id])
  submittedByAccountId String
  submittedByAccount   Account  @relation("GaRequestSubmittedBy", fields: [submittedByAccountId], references: [id])
  submittedAt          DateTime @default(now())

  // Required for DAMAGE_OR_ABNORMAL_CONDITION/LOSS (an existing asset);
  // null for NEW_ASSET_NEED (nothing exists yet to reference).
  assetId    String?
  asset      FixedAsset?    @relation(fields: [assetId], references: [id])
  // Optional — reused Phase 4A master data, never a new location concept.
  locationId String?
  location   AssetLocation? @relation(fields: [locationId], references: [id])

  verifiedAt          DateTime?
  verifiedByAccountId String?
  verifiedByAccount   Account?  @relation("GaRequestVerifiedBy", fields: [verifiedByAccountId], references: [id])
  verificationNote    String?

  // ---- NEW_ASSET_NEED path ----
  // Always true now that GA Admin decides every New Asset Need request
  // directly (no configurable approver Position) — kept nullable so
  // historical requests from when an unconfigured Position meant "no
  // approval needed" still render correctly.
  approvalRequired     Boolean?
  decisionAt           DateTime?
  decisionByAccountId  String?
  decisionByAccount    Account?  @relation("GaRequestDecidedBy", fields: [decisionByAccountId], references: [id])
  decisionNote         String?
  // Exactly one of these two is set once PROCESSED — "Allocate available
  // asset or record procurement reference" (PDF). Plain informational
  // pointer (no Prisma relation), same convention as
  // AssetCustody.transferredToCustodyId already uses in this schema.
  procurementReference String?
  resultingCustodyId   String?
  processedAt          DateTime?
  processedByAccountId String?
  processedByAccount   Account?  @relation("GaRequestProcessedBy", fields: [processedByAccountId], references: [id])

  // ---- LOSS path ----
  lossReviewedAt          DateTime?
  lossReviewedByAccountId String?
  lossReviewedByAccount   Account?  @relation("GaRequestLossReviewedBy", fields: [lossReviewedByAccountId], references: [id])
  lossReviewNote          String?

  evidenceFileId String?     @unique
  evidenceFile   FileObject? @relation("GaRequestEvidence", fields: [evidenceFileId], references: [id])

  cancelledAt          DateTime?
  cancelledByAccountId String?
  cancelledByAccount   Account?  @relation("GaRequestCancelledBy", fields: [cancelledByAccountId], references: [id])
  cancellationReason   String?

  createdAt DateTime @default(now())

  @@index([requesterEmployeeId])
  @@index([status])
  @@index([assetId, status])
  @@index([locationId])
}

// GA-Admin-created preventive schedule for an asset. "Due" detection is
// dueDate-driven (derive-on-read, same pattern as every other due-date
// check in this app) — intervalDays/intervalKm are descriptive reference
// fields GA Admin uses to decide the next dueDate manually, not a fully
// automatic interval-rollover engine (documented simplification).
model MaintenancePlan {
  id                  String     @id @default(cuid())
  assetId             String
  asset               FixedAsset @relation(fields: [assetId], references: [id])
  description         String
  dueDate             DateTime?
  intervalDays        Int?
  intervalKm          Int?
  // Next due odometer, rolled forward when a work order is recorded (intervalKm is the step).
  dueKm               Int?
  // The daily job opens a preventive work order by itself once the plan is due.
  autoCreateWorkOrder Boolean    @default(false)
  activeFlag          Boolean    @default(true)

  createdByAccountId String
  createdByAccount   Account  @relation("MaintenancePlanCreatedBy", fields: [createdByAccountId], references: [id])
  createdAt          DateTime @default(now())

  @@index([activeFlag, dueDate])
}

enum MaintenanceSourceType {
  PREVENTIVE
  CORRECTIVE
}

enum MaintenanceWorkType {
  INTERNAL
  VENDOR
}

enum MaintenanceStatus {
  OPEN
  COMPLETED
}

enum MaintenanceOutcome {
  OPERATIONAL
  BEYOND_REPAIR
}

// PREVENTIVE work orders originate from a MaintenancePlan; CORRECTIVE ones
// from a GaRequest (DAMAGE_OR_ABNORMAL_CONDITION). sourcePlanId/
// sourceGaRequestId are plain informational pointers (no Prisma relation,
// same convention as AssetCustody.transferredToCustodyId) — exactly one is
// set, matching sourceType. Completing with outcome BEYOND_REPAIR
// auto-drafts a DisposalCase (lib/ga-operations.ts); OPERATIONAL just
// updates the asset's condition/nextDue fields.
model MaintenanceWorkOrder {
  id                String                @id @default(cuid())
  workOrderNumber   String                @unique
  assetId           String
  asset             FixedAsset            @relation(fields: [assetId], references: [id])
  sourceType        MaintenanceSourceType
  sourcePlanId      String?
  sourceGaRequestId String?
  workType          MaintenanceWorkType
  checklistNotes    String?
  status            MaintenanceStatus     @default(OPEN)

  createdByAccountId String
  createdByAccount   Account  @relation("MaintenanceWorkOrderCreatedBy", fields: [createdByAccountId], references: [id])
  createdAt          DateTime @default(now())

  serviceDate     DateTime?
  odometerKm      Int?
  diagnosisNote   String?
  actionTakenNote String?
  cost            Float?
  evidenceFileId  String?             @unique
  evidenceFile    FileObject?         @relation("MaintenanceWorkOrderEvidence", fields: [evidenceFileId], references: [id])
  outcome         MaintenanceOutcome?
  nextDueDate     DateTime?
  nextDueKm       Int?

  completedByAccountId String?
  completedByAccount   Account?  @relation("MaintenanceWorkOrderCompletedBy", fields: [completedByAccountId], references: [id])
  completedAt          DateTime?

  @@index([status])
  @@index([assetId, status])
  @@index([sourcePlanId, status])
  @@index([sourceGaRequestId])
}

enum DisposalReason {
  BEYOND_REPAIR
  OBSOLETE
  CONFIRMED_LOSS
}

enum DisposalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXECUTED
}

enum DisposalMethod {
  RETIRE
  DISPOSE
  SELL_AS_SCRAP
}

// "Beyond Repair, Obsolete or Confirmed Loss automatically creates a draft
// Disposal Case" — OBSOLETE is the one manually-triggered reason (a direct
// GA Admin action on the asset; the PDF lists it as an entry point but
// shows no separate flow producing it). sourceWorkOrderId/sourceGaRequestId
// are plain informational pointers (no Prisma relation, same convention as
// elsewhere in this schema) — at most one is set, matching reason.
// Rejected proposals return to DRAFT ("No: repair, storage or review" in
// the PDF) rather than being deleted — immutable history, never silently
// overwritten.
model DisposalCase {
  id         String         @id @default(cuid())
  caseNumber String         @unique
  assetId    String
  asset      FixedAsset     @relation(fields: [assetId], references: [id])
  reason     DisposalReason
  status     DisposalStatus @default(DRAFT)

  sourceWorkOrderId String?
  sourceGaRequestId String?

  proposalNote           String?
  proposalEvidenceFileId String?     @unique
  proposalEvidenceFile   FileObject? @relation("DisposalCaseProposalEvidence", fields: [proposalEvidenceFileId], references: [id])
  submittedForApprovalAt DateTime?

  decisionAt          DateTime?
  decisionByAccountId String?
  decisionByAccount   Account?  @relation("DisposalCaseDecidedBy", fields: [decisionByAccountId], references: [id])
  decisionNote        String?

  executionMethod         DisposalMethod?
  executionDate           DateTime?
  executionValue          Float?
  executionReference      String?
  executionEvidenceFileId String?         @unique
  executionEvidenceFile   FileObject?     @relation("DisposalCaseExecutionEvidence", fields: [executionEvidenceFileId], references: [id])
  executedByAccountId     String?
  executedByAccount       Account?        @relation("DisposalCaseExecutedBy", fields: [executedByAccountId], references: [id])

  createdByAccountId String
  createdByAccount   Account  @relation("DisposalCaseCreatedBy", fields: [createdByAccountId], references: [id])
  createdAt          DateTime @default(now())

  @@index([status])
  @@index([assetId, status])
}

// One row per numbering series and year (key like "OFB-2026"). nextSequence()
// (src/lib/number-sequence.ts) bumps lastValue atomically, so two people
// saving at the same moment can never receive the same case number.
model NumberSequence {
  key       String @id
  lastValue Int    @default(0)
}

enum AccountTokenPurpose {
  INVITE
  RESET
}

// One-time link behind "Buat kata sandi" (invitation) and "Atur ulang kata
// sandi". Only the SHA-256 of the token is stored, so a database leak can't be
// used to take over an account. See src/lib/account-tokens.ts.
model AccountToken {
  id        String              @id @default(cuid())
  accountId String
  account   Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash String              @unique
  purpose   AccountTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([accountId])
}

// Bytes of every uploaded file (BPJS cards, GA/absence/training evidence ...),
// keyed by FileObject.storageKey. Kept in the database because the app runs
// on Vercel, whose disk is read-only, so a local folder cannot hold uploads.
// Access control stays in /api/files/[id]; this table is never read directly.
model FileBlob {
  storageKey String   @id
  data       Bytes
  createdAt  DateTime @default(now())
}

// ---------- Recruitment pipeline: applicants, tests, interviews, offers ----------
// Applicants sit under a RecruitmentRequest. External applicants use the public
// page /cbp-recruitment (no login, a per-request access code); internal ones are
// employees who apply while signed in. All tests, questions, interview aspects and
// message templates below are edited by HR Admin in the app (Pengaturan Rekrutmen).

// Who may apply for a request. NONE = not published anywhere (the default).
enum RecruitmentOpenFor {
  NONE
  EXTERNAL
  INTERNAL
  BOTH
}

enum RecruitmentCandidateSource {
  EXTERNAL
  INTERNAL
}

enum RecruitmentCandidateStatus {
  TESTING // still has tests to take
  AWAITING_REVIEW // all tests taken, an essay waits for a reviewer
  TEST_PASSED // every required test passed, ready for an interview invitation
  TEST_FAILED
  INTERVIEWING // invited / interviewed, waiting for the final decision
  OFFERING // external: offering letter stage
  MOVEMENT // internal: Perubahan Posisi (Promosi/Mutasi) stage
  HIRED // employee created (external) or movement implemented (internal)
  REJECTED
  OFFER_DECLINED
  NOT_SELECTED // the request got filled by someone else
}

enum RecruitmentTestForm {
  SCALE // statements answered 1-5, scored automatically
  MULTIPLE_CHOICE // one correct option, scored automatically
  ESSAY // read and judged by a reviewer HR Admin picks
}

enum RecruitmentCandidateTestStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
}

enum RecruitmentInterviewDecision {
  ACCEPTED
  CONSIDERED
  REJECTED
}

enum RecruitmentInterviewMode {
  OFFLINE
  ONLINE
}

enum RecruitmentOfferResponse {
  ACCEPTED
  DECLINED
}

// One row per kind of test (Cultural Fit, Ketelitian, Studi Kasus ...). The gate
// test (Cultural Fit) is taken first by every applicant; other tests are attached
// to a job title through RecruitmentJobTest.
model RecruitmentTestType {
  id               String              @id @default(cuid())
  name             String              @unique
  description      String?
  form             RecruitmentTestForm
  passScore        Int                 @default(70) // percent, ignored for ESSAY
  timeLimitMinutes Int                 @default(15)
  isGate           Boolean             @default(false)
  // Tests with the same non-empty group are alternatives (e.g. Ketelitian Set A and Set B): each
  // applicant gets ONE of them, the one handed out least so far. Applicants only see the group name.
  variantGroup     String?
  // Questions in a fixed-width font, so look-alike characters (I, l, 1, O, 0) can be told apart.
  monospace        Boolean             @default(false)
  // Multiple choice: every applicant sees the options in their own order (the same order on a refresh),
  // so "the answer is always C" cannot be passed around. Options like "Semua benar" stay last.
  shuffleOptions   Boolean             @default(false)
  // From this percent the result is labelled "Istimewa" for HR (empty = no label).
  excellentScore   Int?
  sortOrder        Int                 @default(0)
  active           Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  questions      RecruitmentTestQuestion[]
  jobTests       RecruitmentJobTest[]
  candidateTests RecruitmentCandidateTest[]
}

model RecruitmentTestQuestion {
  id            String              @id @default(cuid())
  testTypeId    String
  testType      RecruitmentTestType @relation(fields: [testTypeId], references: [id])
  sortOrder     Int                 @default(0)
  prompt        String
  // MULTIPLE_CHOICE only: the options and which one is right.
  options       String[]
  correctIndex  Int?
  // SCALE only: a statement worded the other way round is scored 6 - answer.
  reverseScored Boolean             @default(false)
  active        Boolean             @default(true)
  createdAt     DateTime            @default(now())

  answers RecruitmentCandidateAnswer[]

  @@index([testTypeId, active])
}

// Which extra tests a job title needs (Cultural Fit is always required on top).
model RecruitmentJobTest {
  jobId      String
  job        Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  testTypeId String
  testType   RecruitmentTestType @relation(fields: [testTypeId], references: [id], onDelete: Cascade)

  @@id([jobId, testTypeId])
}

// What each interviewer scores 1-5; HR Admin edits this list.
model RecruitmentInterviewAspect {
  id        String  @id @default(cuid())
  label     String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  scores RecruitmentInterviewScore[]
}

// Single settings row (id "default").
model RecruitmentSetting {
  id                      String   @id @default("default")
  defaultInterviewers     Int      @default(1)
  maxInterviewers         Int      @default(4)
  retakeDays              Int      @default(30)
  retentionDays           Int      @default(30)
  invitationEmailTemplate String   @default("Yth. {nama}, kami mengundang Anda interview untuk posisi {posisi} pada {tanggal} pukul {jam} di {lokasi}. Mohon konfirmasi kehadiran dengan membalas pesan ini.")
  invitationWaTemplate    String   @default("Halo {nama}, ini HR PT CBP. Interview untuk posisi {posisi}: {tanggal}, pukul {jam}, di {lokasi}. Mohon balas pesan ini untuk konfirmasi.")
  updatedAt               DateTime @updatedAt
}

// A CV or an offering letter. Bytes live in FileBlob under storageKey, like every
// other upload; downloads go only through /api/recruitment/files/[id] (HR Admin,
// or the interviewer/reviewer assigned to that applicant) or the offer link.
model RecruitmentFile {
  id         String   @id @default(cuid())
  storageKey String   @unique
  fileName   String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  candidatesWithCv RecruitmentCandidate[] @relation("RecruitmentCandidateCv")
  offers           RecruitmentOffer[]
}

model RecruitmentCandidate {
  id                 String                        @id @default(cuid())
  requestId          String
  request            RecruitmentRequest            @relation(fields: [requestId], references: [id])
  source             RecruitmentCandidateSource
  // Internal applicants: the employee. External: set once they are hired.
  employeeId         String?
  employee           Employee?                     @relation("RecruitmentCandidateEmployee", fields: [employeeId], references: [id])
  fullName           String
  email              String // always lowercase
  mobileNumber       String?
  cvFileId           String?
  cvFile             RecruitmentFile?              @relation("RecruitmentCandidateCv", fields: [cvFileId], references: [id])
  status             RecruitmentCandidateStatus    @default(TESTING)
  statusChangedAt    DateTime                      @default(now())
  // SHA-256 of the private test link (external applicants). Internal applicants
  // take tests while signed in, so they have none.
  tokenHash          String?                       @unique
  interviewDecision  RecruitmentInterviewDecision?
  decisionNote       String?
  decidedAt          DateTime?
  decidedByAccountId String?
  // Set when the applicant leaves the pipeline without being hired. Drives the
  // re-apply waiting time and the clean-up of old data.
  closedAt           DateTime?
  closeReason        String?
  movementRequestId  String?                       @unique
  movementRequest    MovementRequest?              @relation("RecruitmentCandidateMovement", fields: [movementRequestId], references: [id])
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  tests     RecruitmentCandidateTest[]
  interview RecruitmentInterview?
  offer     RecruitmentOffer?
  assessment RecruitmentAssessmentSubmission?

  @@index([requestId, status])
  @@index([email])
  @@index([status, closedAt])
  @@index([employeeId])
}

model RecruitmentCandidateTest {
  id                   String                         @id @default(cuid())
  candidateId          String
  candidate            RecruitmentCandidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  testTypeId           String
  testType             RecruitmentTestType            @relation(fields: [testTypeId], references: [id])
  sortOrder            Int                            @default(0)
  status               RecruitmentCandidateTestStatus @default(NOT_STARTED)
  startedAt            DateTime?
  deadlineAt           DateTime?
  submittedAt          DateTime?
  autoSubmitted        Boolean                        @default(false)
  scorePercent         Float?
  // null = not graded yet (essay waiting for a reviewer)
  passed               Boolean?
  passScoreSnapshot    Int?
  reviewNote           String?
  reviewedAt           DateTime?
  reviewedByEmployeeId String?

  answers   RecruitmentCandidateAnswer[]
  reviewers RecruitmentTestReviewer[]

  @@unique([candidateId, testTypeId])
  @@index([status, deadlineAt])
  @@index([testTypeId])
}

model RecruitmentCandidateAnswer {
  id              String                   @id @default(cuid())
  candidateTestId String
  candidateTest   RecruitmentCandidateTest @relation(fields: [candidateTestId], references: [id], onDelete: Cascade)
  questionId      String
  question        RecruitmentTestQuestion  @relation(fields: [questionId], references: [id])
  answerIndex     Int? // option index (multiple choice) or 1-5 (scale)
  answerText      String? // essay
  updatedAt       DateTime                 @updatedAt

  @@unique([candidateTestId, questionId])
}

// Who HR Admin let read (and judge) one essay test.
model RecruitmentTestReviewer {
  id                 String                   @id @default(cuid())
  candidateTestId    String
  candidateTest      RecruitmentCandidateTest @relation(fields: [candidateTestId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee                 @relation("RecruitmentTestReviewerEmployee", fields: [employeeId], references: [id])
  grantedByAccountId String
  createdAt          DateTime                 @default(now())

  @@unique([candidateTestId, employeeId])
  @@index([employeeId])
}

model RecruitmentInterview {
  id                 String                   @id @default(cuid())
  candidateId        String                   @unique
  candidate          RecruitmentCandidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  scheduledAt        DateTime
  mode               RecruitmentInterviewMode
  location           String // room, address or meeting link
  invitationSentAt   DateTime?
  // The administrative part HR Admin fills in.
  hrAttendanceNote   String?
  hrDocumentsNote    String?
  hrProcessNote      String?
  createdByAccountId String
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  interviewers RecruitmentInterviewer[]
}

model RecruitmentInterviewer {
  id             String                        @id @default(cuid())
  interviewId    String
  interview      RecruitmentInterview          @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee                      @relation("RecruitmentInterviewerEmployee", fields: [employeeId], references: [id])
  recommendation RecruitmentInterviewDecision?
  note           String?
  submittedAt    DateTime?
  createdAt      DateTime                      @default(now())

  scores RecruitmentInterviewScore[]

  @@unique([interviewId, employeeId])
  @@index([employeeId, submittedAt])
}

model RecruitmentInterviewScore {
  id            String                     @id @default(cuid())
  interviewerId String
  interviewer   RecruitmentInterviewer     @relation(fields: [interviewerId], references: [id], onDelete: Cascade)
  aspectId      String
  aspect        RecruitmentInterviewAspect @relation(fields: [aspectId], references: [id])
  aspectLabel   String // label when scored, so a later rename does not rewrite history
  score         Int // 1-5

  @@unique([interviewerId, aspectId])
}

// Offering letter for an external applicant: HR Admin uploads the PDF and signs
// for the company on screen, the applicant opens a one-time link, signs on screen
// and accepts or declines.
model RecruitmentOffer {
  id                       String                    @id @default(cuid())
  candidateId              String                    @unique
  candidate                RecruitmentCandidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fileId                   String
  file                     RecruitmentFile           @relation(fields: [fileId], references: [id])
  companySignature         String // PNG data URL drawn on screen
  companySignedAt          DateTime
  companySignedByAccountId String
  tokenHash                String?                   @unique
  tokenExpiresAt           DateTime?
  sentAt                   DateTime?
  response                 RecruitmentOfferResponse?
  respondedAt              DateTime?
  candidateSignature       String?
  // true when HR Admin recorded the answer (e.g. given by phone) instead of the link
  recordedByHr             Boolean                   @default(false)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
}

// ---------- Recruitment assessment "Tes Situasi Kerja" (behavioral risk screening) ----------
// The question bank of one assessment version is fixed once imported; what HR reviews and
// approves is a RUBRIC (observation + risk signal per answer option). An approved rubric is
// locked: a change is a new rubric version. A candidate's result keeps a snapshot of every
// interpretation used, so approving a later rubric never changes a past score.

enum AssessmentRubricStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  ARCHIVED
}

enum AssessmentSubmissionStatus {
  IN_PROGRESS
  SUBMITTED
}

enum AssessmentScreeningStatus {
  INCOMPLETE
  NO_AGGREGATE_CONCERN
  INTERVIEW_ATTENTION
  PRIORITY_REVIEW
}

model RecruitmentAssessmentVersion {
  id                 String   @id @default(cuid())
  versionLabel       String   @unique // "V3.2"
  name               String
  organization       String
  language           String
  instructions       String[]
  closingText        String
  estimatedMinMin    Int
  estimatedMinMax    Int
  // SHA-256 of the imported question bank file, so the text can be traced to its source.
  sourceSha256       String
  createdByAccountId String
  createdAt          DateTime @default(now())

  questions   RecruitmentAssessmentQuestion[]
  rubrics     RecruitmentAssessmentRubric[]
  submissions RecruitmentAssessmentSubmission[]
}

model RecruitmentAssessmentQuestion {
  id           String                       @id @default(cuid())
  versionId    String
  version      RecruitmentAssessmentVersion @relation(fields: [versionId], references: [id])
  questionNo   Int // 1..20, also the approved display sequence
  questionCode String // "Q01"
  scenario     String
  prompt       String

  options RecruitmentAssessmentOption[]
  answers RecruitmentAssessmentAnswer[]

  @@unique([versionId, questionNo])
}

model RecruitmentAssessmentOption {
  id         String                        @id @default(cuid())
  questionId String
  question   RecruitmentAssessmentQuestion @relation(fields: [questionId], references: [id])
  optionKey  String // "A".."D"
  text       String

  interpretations RecruitmentAssessmentInterpretation[]
  answers         RecruitmentAssessmentAnswer[]

  @@unique([questionId, optionKey])
}

model RecruitmentAssessmentRubric {
  id                   String                       @id @default(cuid())
  versionId            String
  version              RecruitmentAssessmentVersion @relation(fields: [versionId], references: [id])
  rubricLabel          String // "V3.2-R1"
  status               AssessmentRubricStatus       @default(DRAFT)
  // Copied from the source package: legend and the screening thresholds.
  riskSignalLegend     Json
  thresholds           Json
  sourceNote           String?
  sourceSha256         String?
  basedOnRubricId      String? // a revision starts from a copy of this rubric
  submittedAt          DateTime?
  submittedByAccountId String?
  decidedAt            DateTime? // approved or returned
  decidedByAccountId   String?
  decisionNote         String?
  approvedAt           DateTime?
  approvedByAccountId  String?
  activatedAt          DateTime?
  activatedByAccountId String?
  archivedAt           DateTime?
  createdByAccountId   String
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  interpretations RecruitmentAssessmentInterpretation[]
  events          RecruitmentAssessmentRubricEvent[]
  submissions     RecruitmentAssessmentSubmission[]
  resultItems     RecruitmentAssessmentResultItem[]

  @@unique([versionId, rubricLabel])
  @@index([versionId, status])
}

model RecruitmentAssessmentInterpretation {
  id                    String                      @id @default(cuid())
  rubricId              String
  rubric                RecruitmentAssessmentRubric @relation(fields: [rubricId], references: [id])
  optionId              String
  option                RecruitmentAssessmentOption @relation(fields: [optionId], references: [id])
  questionNo            Int
  optionKey             String
  assessmentType        String // RISK or PREFERENCE (from the source package)
  primaryDimension      String
  observation           String
  riskSignal            Int // 0, -1 or -2
  requiresControlReview Boolean                     @default(false)
  updatedAt             DateTime                    @updatedAt

  resultItems RecruitmentAssessmentResultItem[]

  @@unique([rubricId, optionId])
  @@index([rubricId, questionNo])
}

// Append-only history of a rubric: created, edited, submitted, returned, approved, activated, archived.
model RecruitmentAssessmentRubricEvent {
  id             String                      @id @default(cuid())
  rubricId       String
  rubric         RecruitmentAssessmentRubric @relation(fields: [rubricId], references: [id])
  action         String
  actorAccountId String
  note           String?
  createdAt      DateTime                    @default(now())

  @@index([rubricId, createdAt])
}

model RecruitmentAssessmentSubmission {
  id              String                       @id @default(cuid())
  candidateId     String                       @unique
  candidate       RecruitmentCandidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  versionId       String
  version         RecruitmentAssessmentVersion @relation(fields: [versionId], references: [id])
  // The ACTIVE rubric when the candidate started; the final score is calculated with it.
  rubricId        String
  rubric          RecruitmentAssessmentRubric  @relation(fields: [rubricId], references: [id])
  status          AssessmentSubmissionStatus   @default(IN_PROGRESS)
  startedAt       DateTime                     @default(now())
  submittedAt     DateTime?
  scoredAt        DateTime?
  totalScore      Int?
  screeningStatus AssessmentScreeningStatus?
  engineVersion   String?
  updatedAt       DateTime                     @updatedAt

  answers RecruitmentAssessmentAnswer[]
  items   RecruitmentAssessmentResultItem[]

  @@index([status])
  @@index([versionId])
  @@index([rubricId])
}

model RecruitmentAssessmentAnswer {
  id           String                          @id @default(cuid())
  submissionId String
  submission   RecruitmentAssessmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  question     RecruitmentAssessmentQuestion   @relation(fields: [questionId], references: [id])
  optionId     String
  option       RecruitmentAssessmentOption     @relation(fields: [optionId], references: [id])
  updatedAt    DateTime                        @updatedAt

  @@unique([submissionId, questionId])
  @@index([questionId])
  @@index([optionId])
}

// What HR sees for one answered question: written once at scoring, never updated.
model RecruitmentAssessmentResultItem {
  id                    String                              @id @default(cuid())
  submissionId          String
  submission            RecruitmentAssessmentSubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionNo            Int
  rubricId              String
  rubric                RecruitmentAssessmentRubric         @relation(fields: [rubricId], references: [id])
  interpretationId      String
  interpretation        RecruitmentAssessmentInterpretation @relation(fields: [interpretationId], references: [id])
  optionKey             String
  // Snapshots, so the record reads the same whatever happens to the master data later.
  questionText          String
  optionText            String
  primaryDimension      String
  observation           String
  riskSignal            Int
  assessmentType        String
  requiresControlReview Boolean

  @@unique([submissionId, questionNo])
  @@index([rubricId])
  @@index([interpretationId])
}
