// PT Cahaya Bukit Perunggu HR App — Prisma schema
// Source of truth for field/entity decisions: docs/DECISIONS.md and the HR App Build Guide /
// HR App Data Fields Blueprint (see CLAUDE.md for links and priority order).
//
// Scope note: this schema currently covers Phase 0 (Foundation), Phase 1
// (Employee & Organization), and Phase 2 (Employee Lifecycle) slices for
// Recruitment and Movement:
// - Recruitment Request -> approval -> Create Employee -> initial Primary
//   Assignment -> fulfillment-link flow (DEC-013, DM-21..DM-23, WF-13..
//   WF-14), corrected so decision authority is Position-derived HR Manager
//   only, with HR Admin as a separate operational account and
//   Requester/HR Manager/HR Admin cancellation (ACC-14..16, WF-15, DM-25,
//   DEC-004/015/016/018).
// - Movement Request -> HR Manager decision -> HR Admin execution flow
//   (LIF-04, Data Fields Blueprint "28 Movement Requests"), reusing the
//   Phase 1 Assignment model rather than rebuilding it.
// - Onboarding Case (LIF-03, Data Fields Blueprint "12 Onboarding"): created
//   automatically alongside every new Employee (direct creation or
//   Recruitment fulfillment), tracked via three admin-owned completion
//   flags (contract/training-material/assets) with a live-computed overall
//   status — never a stored one.
// - Contract + renewal pipeline (WF-10, LIF-08..12, Data Fields Blueprint
//   "08 Contracts"): a single Contract model whose own `status` carries the
//   full WF-10 state machine (an expiring contract moves through the
//   Department-Manager-recommends -> HR-Manager-decides states; an
//   approved renewal creates a NEW Contract row that moves through
//   Draft -> Released -> Signed -> Active while the old one ends).
// Explicitly NOT modeled: Manpower, Candidate, Selected Person (DEC-013
// excludes them), and the rest of Phase 2 (resignation, exit clearance)
// plus later phases (Competency, Training, Assets, Payroll-slip import) —
// these belong to later increments and will
// be added when those increments start.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------- Enums ----------

enum AccountType {
  EMPLOYEE_LOGIN
  ADMIN
}

// Named admin capability scope. Separate from AppRole: an Account can be ADMIN type
// with a scope AND still be linked to an Employee (e.g. a manager who is also GA admin).
enum AdminScope {
  PEOPLE_PAYROLL
  TRAINING
  ASSETS
  NONE
}

enum AccountStatus {
  INVITED
  ACTIVE
  LOCKED
  DISABLED
}

// Manager/Approver is deliberately NOT a role here — per ACC-05 that authority is
// derived at request time from the employee's active Position assignments
// (does any Position report to me?), never a stored flag.
enum AppRole {
  HR_ADMIN
  TRAINING_ADMIN
  GA_ADMIN
  EMPLOYEE
}

enum Gender {
  MALE
  FEMALE
}

enum EmploymentStatus {
  PKWTT
  PKWT
  HARIAN_LEPAS
  MAGANG
}

enum UnitType {
  DEPARTMENT
  SECTION
  GROUP
  TEAM
}

enum PositionType {
  STAFF
  TEAM_LEAD
  SECTION_HEAD
  DEPARTMENT_HEAD
  DIRECTOR
}

enum PositionStatus {
  PLANNED
  VACANT
  FILLED
  FROZEN
  CLOSED
}

enum AssignmentType {
  PRIMARY
  ADDITIONAL
  ACTING
  TEMPORARY
}

enum AssignmentStatus {
  ACTIVE
  ENDED
}

enum Sensitivity {
  INTERNAL
  RESTRICTED
  HIGHLY_RESTRICTED
}

enum ImportStatus {
  UPLOADED
  VALIDATED
  NEEDS_FIX
  POSTED
  ROLLED_BACK
}

// LIF-03 / Data Fields Blueprint "12 Onboarding": computed live from the
// three completion flags + planned_start_date/mandatory_material_due_date —
// never stored directly.
enum OnboardingOverallStatus {
  NOT_STARTED
  IN_PROGRESS
  OVERDUE
  COMPLETE
}

// DM-25 / WF-13: who had the authority to cancel a Recruitment Request.
enum CancellationAuthority {
  REQUESTER
  HR_MANAGER
  HR_ADMIN
}

// WF-10: one enum carries the full renewal pipeline. DRAFT/RELEASED/SIGNED
// apply to a brand-new Contract on its way to becoming ACTIVE; ACTIVE is the
// steady state (no renewal in progress); REVIEW_REQUESTED..NOT_RENEWED apply
// to an existing ACTIVE contract as its own end date approaches; ENDED is
// the final historical state once superseded by a newer Contract or expired
// without renewal.
enum ContractStatus {
  DRAFT
  RELEASED
  SIGNED
  ACTIVE
  REVIEW_REQUESTED
  RECOMMENDATION_SUBMITTED
  APPROVED_FOR_RENEWAL
  NOT_RENEWED
  ENDED
}

enum ContractRenewalRecommendation {
  RENEW
  NOT_RENEW
}

enum AuditAction {
  VIEW
  CREATE
  UPDATE
  APPROVE
  REJECT
  IMPORT
  EXPORT
  PRINT
  RELEASE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
}

// ---------- Phase 2: simplified Recruitment Request (DEC-013, DM-21..23) ----------
// Every value below is taken directly from the current FR-HC-01-01 form
// (Formulir Permintaan Tenaga Kerja Baru), per SRC-07.

enum RecruitmentReasonCode {
  REPLACEMENT // Pengganti karyawan keluar
  ADDITIONAL // Penambahan karena kebutuhan
  DEVELOPMENT // Penyesuaian perkembangan PT CBP
}

enum ShiftCode {
  SHIFT
  NON_SHIFT
}

enum EducationRequirementCode {
  S1_UNIVERSITY // Universitas / S1
  D1_D3_ACADEMY // Akademi D3 / D1
  SMA // SMA Sederajat
}

enum WorkExperienceBand {
  NONE // Tidak Pengalaman
  ONE_TO_TWO // 1-2 tahun
  THREE_TO_FOUR // 3-4 tahun
  MORE_THAN_FIVE // >5 tahun
}

enum AgeBand {
  AGE_18_25
  AGE_26_35
  AGE_36_45
}

enum RequestedJobLevel {
  DEPARTMENT_HEAD
  SECTION_HEAD
  SUPERVISOR
  STAFF_OPERATOR
  HARIAN_LEPAS
}

// WF-13: Draft > Submitted > Under Review > Approved/Rejected/Returned >
// Recruitment In Progress > Partially Filled > Filled > Closed/Cancelled.
// Only Approved, Recruitment In Progress or Partially Filled requests may
// create Employees.
enum RecruitmentRequestStatus {
  DRAFT
  // Department Manager/Head (Job level 3B) approval gate, ahead of the HR
  // Manager — inserted per direct user request. A request only reaches
  // SUBMITTED (the HR Manager's queue) after this stage clears, unless the
  // requester's own current Position is already level 3B in this
  // department, in which case it's skipped entirely.
  PENDING_DEPT_HEAD
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RETURNED
  RECRUITMENT_IN_PROGRESS
  PARTIALLY_FILLED
  FILLED
  CLOSED
  CANCELLED
}

// ---------- Phase 2: Movement Request (LIF-04, Data Fields Blueprint "28 Movement Requests") ----------
// source_evaluation_id, competency_readiness_percent, attendance_summary, and
// training_readiness from the blueprint are deliberately NOT modeled yet —
// they reference Evaluation/Competency/Attendance/Training, none of which
// exist in this app (Phase 3/5). Adding stub FKs to nonexistent datasets now
// would be speculative; revisit when those phases start.

enum MovementType {
  PROMOTION
  ROTATION
  MUTATION
  DEMOTION
  STATUS_CHANGE
}

// Perubahan Posisi refactor (2026-07-31): PENDING_DEPT_HEAD and RETURNED
// added ahead of the Blueprint's original approval_status values, for the
// new Department Head 3B -> HR Manager two-stage approval chain. Purely
// additive — every pre-existing row (any movementType, any of the original
// five statuses) remains a valid row under this enum; nothing was removed.
enum MovementRequestStatus {
  PENDING_DEPT_HEAD
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED
  IMPLEMENTED
  CANCELLED
}

// ---------- Phase 2: Contract Renewal Case (DM-15, DM-26, WF-10..12, LIF-08..13) ----------
// The blueprint's automated D-30 case: FR-HC-01-07's dual-evaluator (P1/P2)
// form, the primary Department Head's recommendation (Level 3B, same
// definition as Perubahan Posisi's dept-head gate — see dept-head.ts), and a
// combined HR Manager decision that can also approve a linked Perubahan
// Posisi draft in one action (DEC-019). This is layered ADDITIVELY next to
// the existing single-recommender Contract fields above (reviewRequestedAt..
// decisionNote) — that manual path remains valid for a renewal not started
// by this automated case; this model owns the richer workflow end to end and
// only touches Contract itself at the very end (via the same
// createRenewalDraftContract/markContractNotRenewed mutations the manual
// path already uses).
enum RenewalRecommendation {
  PERPANJANG_3
  PERPANJANG_6
  PERPANJANG_12
  TIDAK_DIPERPANJANG
  MUTASI
  DEMOSI
}

// WF-10: Upcoming Expiry (D-30) > HR Admin Review > Evaluation Sent >
// [Waiting for P1/P2 is derived live from p1SubmittedAt/p2SubmittedAt, not a
// separate stored state] > Department Head Recommendation [likewise derived
// live from deptHeadRecommendedAt] > Pending HR Manager Combined Review >
// Returned/Rejected/Approved.
enum ContractRenewalCaseStatus {
  TRIGGERED
  EVALUATION_SENT
  PENDING_HR_MANAGER
  RETURNED
  REJECTED
  APPROVED
  CANCELLED
}

model ContractRenewalCase {
  id                String                    @id @default(cuid())
  caseNumber        String                    @unique
  currentContractId String                    @unique
  currentContract   Contract                  @relation("RenewalCurrentContract", fields: [currentContractId], references: [id])
  employeeId        String
  employee          Employee                  @relation("RenewalCaseEmployee", fields: [employeeId], references: [id])
  // DM-15 "primary_assignment_id and organization snapshot" — department/
  // section are re-derived live via level3-scope.ts's resolveDepartmentId/
  // resolveSectionId from snapshotPositionId, same pattern as
  // MovementRequest's currentPositionId/currentAssignmentId, rather than
  // duplicating department/section text fields that could drift.
  primaryAssignmentId String
  primaryAssignment   Assignment              @relation(fields: [primaryAssignmentId], references: [id])
  snapshotPositionId  String
  snapshotPosition    Position                @relation("RenewalSnapshotPosition", fields: [snapshotPositionId], references: [id])

  status      ContractRenewalCaseStatus       @default(TRIGGERED)
  triggerDate DateTime                        @default(now())

  // HR Admin review + manual send (DM-15, ACC-11).
  responsibleHrAdminAccountId String?
  responsibleHrAdminAccount  Account?          @relation("RenewalResponsibleHrAdmin", fields: [responsibleHrAdminAccountId], references: [id])
  sentAt                     DateTime?
  evaluationDueDate          DateTime?

  // FR-HC-01-07 HR-owned prefilled attendance snapshot (DM-26) — Sakit,
  // Ijin, Alfa, Ijin 1/2 Hari only (no Cuti, unlike Movement's 5-field set).
  attendanceSakit       Int?
  attendanceIjin        Int?
  attendanceAlpha       Int?
  attendanceIjinHalfDay Int?

  // P1/P2 evaluators (DM-15/DM-26/ACC-11: must be two different people, each
  // sees/submits only their own assigned evaluation, both auditable and
  // separate). Itemized FR-HC-01-07 criteria scores are stored as JSON
  // rather than ~13 mostly-null columns per evaluator, since KPI/Productivity
  // and its 5 alternative criteria are mutually exclusive on the real form.
  p1EmployeeId  String?
  p1Employee    Employee?                     @relation("RenewalP1Evaluator", fields: [p1EmployeeId], references: [id])
  p1PositionId  String?
  p1Position    Position?                     @relation("RenewalP1Position", fields: [p1PositionId], references: [id])
  p1SubmittedAt DateTime?
  p1Scores      Json?
  p1Total       Int?

  p2EmployeeId  String?
  p2Employee    Employee?                     @relation("RenewalP2Evaluator", fields: [p2EmployeeId], references: [id])
  p2PositionId  String?
  p2Position    Position?                     @relation("RenewalP2Position", fields: [p2PositionId], references: [id])
  p2SubmittedAt DateTime?
  p2Scores      Json?
  p2Total       Int?

  // Primary Department Head recommendation — LIF-09/DEC-019: this
  // recommendation counts as the Dept Head approval for any linked
  // Perubahan Posisi it creates.
  deptHeadEmployeeId             String?
  deptHeadEmployee               Employee?               @relation("RenewalDeptHeadEmployee", fields: [deptHeadEmployeeId], references: [id])
  deptHeadPositionId             String?
  deptHeadPosition               Position?               @relation("RenewalDeptHeadPosition", fields: [deptHeadPositionId], references: [id])
  deptHeadRecommendedAt          DateTime?
  deptHeadRecommendation         RenewalRecommendation?
  deptHeadProposedDurationMonths Int?
  deptHeadProposedPositionId     String?
  deptHeadProposedPosition       Position?               @relation("RenewalDeptHeadProposedPosition", fields: [deptHeadProposedPositionId], references: [id])
  deptHeadNote                   String?

  // Linked Perubahan Posisi draft (DM-10/LIF-13/DEC-019) — created or
  // updated automatically when a Mutasi/Demosi recommendation is in play;
  // voided (cancelled), never deleted, if the final recommendation moves
  // away from Mutasi/Demosi (WF-12).
  linkedMovementRequestId String?          @unique
  linkedMovementRequest   MovementRequest? @relation("RenewalLinkedMovement", fields: [linkedMovementRequestId], references: [id])

  // HR Manager combined decision (WF-12/ACC-16/DEC-019) — one action updates
  // this case AND the linked Perubahan Posisi (if any) together.
  // finalRecommendation may differ from deptHeadRecommendation; a change
  // requires changeReason (mandatory).
  decisionAt          DateTime?
  decisionByAccountId String?
  decisionByAccount   Account?               @relation("RenewalDecisionBy", fields: [decisionByAccountId], references: [id])
  decisionPositionId  String?
  decisionPosition    Position?              @relation("RenewalDecisionPosition", fields: [decisionPositionId], references: [id])
  finalRecommendation RenewalRecommendation?
  changeReason        String?
  decisionNote         String?

  // Contract-generation gating (WF-12: disabled until the linked Perubahan
  // Posisi is approved/executed, then uses the approved new Position) — the
  // new Contract row is created via the same shared helper the manual
  // renewal path uses, never a duplicated mutation.
  generatedContractId String?   @unique
  generatedContract   Contract? @relation("RenewalGeneratedContract", fields: [generatedContractId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- User Accounts (separate from Employee Master, per ACC-01) ----------

model Account {
  id                    String        @id @default(cuid())
  usernameOrEmail       String        @unique
  passwordHash          String
  accountType           AccountType
  employeeId            String?       @unique
  employee              Employee?     @relation(fields: [employeeId], references: [id])
  adminScope            AdminScope    @default(NONE)
  accountStatus         AccountStatus @default(ACTIVE)
  lastLoginAt           DateTime?
  failedLoginCount      Int           @default(0)
  passwordResetRequired Boolean       @default(false)
  accountDisabledAt     DateTime?
  roles                 AccountRole[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  auditEvents           AuditLog[]
  importBatches         ImportBatch[]
  uploadedFiles         FileObject[]
  recruitmentRequestsSubmittedBy RecruitmentRequest[] @relation("RecruitmentSubmittedBy")
  recruitmentRequestsApprovedBy RecruitmentRequest[] @relation("RecruitmentApprovedBy")
  recruitmentRequestsDeptHeadDecisionsBy RecruitmentRequest[] @relation("RecruitmentDeptHeadDecisionBy")
  recruitmentFulfillmentsLinked RecruitmentRequestFulfillment[]
  recruitmentRequestsCancelledBy RecruitmentRequest[] @relation("RecruitmentCancelledByAccount")
  movementRequestsSubmittedBy   MovementRequest[] @relation("MovementSubmittedBy")
  movementRequestsDecidedBy     MovementRequest[] @relation("MovementDecisionBy")
  movementRequestsDeptHeadDecisionsBy MovementRequest[] @relation("MovementDeptHeadDecisionBy")
  movementRequestsImplementedBy MovementRequest[] @relation("MovementImplementedBy")
  movementRequestsCancelledBy   MovementRequest[] @relation("MovementCancelledByAccount")
  onboardingContractsCompletedBy OnboardingCase[] @relation("OnboardingContractCompletedBy")
  onboardingTrainingCompletedBy  OnboardingCase[] @relation("OnboardingTrainingCompletedBy")
  onboardingAssetsCompletedBy    OnboardingCase[] @relation("OnboardingAssetsCompletedBy")
  contractDecisionsMade          Contract[] @relation("ContractDecisionBy")
  renewalCasesResponsibleAsHrAdmin ContractRenewalCase[] @relation("RenewalResponsibleHrAdmin")
  renewalCasesDecidedBy            ContractRenewalCase[] @relation("RenewalDecisionBy")
}

model AccountRole {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role      AppRole

  @@unique([accountId, role])
}

// ---------- Employee & Organization (Phase 1 core data model) ----------

model Employee {
  id                       String            @id @default(cuid())
  employeeNumber           String            @unique
  fullLegalName            String
  preferredName            String?
  nationalIdNumber         String?
  birthPlace               String?
  birthDate                DateTime?
  gender                   Gender?
  personalEmail            String?
  workEmail                String?           @unique
  mobileNumber             String?
  currentAddress           String?
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?
  bankAccountName          String?
  bankAccountNumber        String?
  taxId                    String?
  bpjsEmploymentNumber     String?
  bpjsHealthNumber         String?
  // DM-17: Kartu Keluarga number. Text, not numeric — must preserve leading
  // zeroes and is never used as a join/relationship key, just stored/validated
  // as exactly 16 digits (see src/lib/validation/employee-fields.ts).
  noKk                     String?
  namaIbuKandung           String?
  // DM-19/DM-20: admin-maintained dropdowns, stored as a stable reference
  // (row id for education, the code itself for PTKP since that's already a
  // stable regulatory identifier), never free text.
  educationLevelId         String?
  educationLevel           EducationLevel?  @relation(fields: [educationLevelId], references: [id])
  ptkpStatusCode           String?
  ptkpStatus               PtkpStatus?      @relation(fields: [ptkpStatusCode], references: [code])
  // DM-18/CTL-12: private file references, never a public URL or base64 blob.
  // A new upload creates a new FileObject and repoints this FK — the
  // superseded FileObject row is kept (still linked via FileObject.employeeId)
  // so replacement history isn't lost.
  ktpFileId                String?           @unique
  ktpFile                  FileObject?       @relation("EmployeeKtpFile", fields: [ktpFileId], references: [id])
  kkFileId                 String?           @unique
  kkFile                   FileObject?       @relation("EmployeeKkFile", fields: [kkFileId], references: [id])
  hireDate                 DateTime
  employmentStatus         EmploymentStatus
  // Denormalized pointer to the Position of this employee's current Primary
  // Assignment, kept in sync by application code. Source of truth for history
  // and for "who holds what" is always the Assignment table, never this field.
  currentPositionId        String?
  currentPosition          Position?         @relation("PositionHolder", fields: [currentPositionId], references: [id])
  activeFlag               Boolean           @default(true)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  account                  Account?
  assignments              Assignment[]      @relation("EmployeeAssignments")
  files                    FileObject[]
  recruitmentRequestsSubmitted RecruitmentRequest[] @relation("RecruitmentRequester")
  recruitmentFulfillment   RecruitmentRequestFulfillment?
  recruitmentRequestsCancelled RecruitmentRequest[] @relation("RecruitmentCancelledByEmployee")
  movementRequests             MovementRequest[] @relation("MovementEmployee")
  movementRequestsSubmitted    MovementRequest[] @relation("MovementRequester")
  movementRequestsCancelled    MovementRequest[] @relation("MovementCancelledByEmployee")
  onboardingCase               OnboardingCase?
  contracts                    Contract[] @relation("EmployeeContracts")
  contractRecommendationsGiven Contract[] @relation("ContractRecommendationBy")
  renewalCases                 ContractRenewalCase[] @relation("RenewalCaseEmployee")
  renewalP1Evaluations         ContractRenewalCase[] @relation("RenewalP1Evaluator")
  renewalP2Evaluations         ContractRenewalCase[] @relation("RenewalP2Evaluator")
  renewalDeptHeadRecommendations ContractRenewalCase[] @relation("RenewalDeptHeadEmployee")
}

// DM-19: admin-maintained master list for Pendidikan Terakhir. Managed via
// /admin/education-levels — never hand-edited in the database.
model EducationLevel {
  id           String     @id @default(cuid())
  label        String     @unique
  displayOrder Int        @default(0)
  activeFlag   Boolean    @default(true)
  createdAt    DateTime   @default(now())

  employees    Employee[]
}

// DM-20: admin-maintained PTKP (Indonesian income-tax status) codes. The
// code itself is stable (regulatory), but the list of codes/labels is
// editable by HR Admin without a code change — managed via /admin/ptkp-status.
model PtkpStatus {
  id           String     @id @default(cuid())
  code         String     @unique
  label        String
  displayOrder Int        @default(0)
  activeFlag   Boolean    @default(true)
  createdAt    DateTime   @default(now())

  employees    Employee[]
}

model OrgUnit {
  id            String    @id @default(cuid())
  unitType      UnitType
  unitCode      String    @unique
  unitName      String
  parentUnitId  String?
  parentUnit    OrgUnit?  @relation("OrgUnitHierarchy", fields: [parentUnitId], references: [id])
  children      OrgUnit[] @relation("OrgUnitHierarchy")
  displayOrder  Int       @default(0)
  activeFlag    Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  positions     Position[]
  recruitmentRequests RecruitmentRequest[]
}

model Job {
  id                String   @id @default(cuid())
  jobCode           String   @unique
  jobTitle          String
  jobLevel          String
  jobPurpose        String?
  pdcaPlan          String?
  pdcaDo            String?
  pdcaCheck         String?
  pdcaAct           String?
  decisionAuthority String?
  keyCollaboration  String?
  jobVersion        Int      @default(1)
  approvalStatus    String   @default("Approved")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  positions         Position[]
  recruitmentRequests RecruitmentRequest[]
}

model Position {
  id                   String         @id @default(cuid())
  positionCode         String         @unique
  jobId                String
  job                  Job            @relation(fields: [jobId], references: [id])
  orgUnitId            String
  orgUnit              OrgUnit        @relation(fields: [orgUnitId], references: [id])
  positionType         PositionType
  approvedFte          Float          @default(1)
  positionStatus       PositionStatus @default(VACANT)
  // ACC-14/DEC-015: functional flag, independent of positionType's hierarchy
  // tier. An Employee holding an ACTIVE Assignment (any type) to a Position
  // with this flag set derives HR Manager authority live — never a stored
  // AccountRole, so access starts/ends automatically with the Assignment's
  // effective dates. See src/lib/hr-manager.ts.
  grantsHrManagerAccess Boolean       @default(false)
  // Sole saved parent-child authority for the org chart (ORG-01). Never inferred
  // from names or job levels.
  reportsToPositionId  String?
  reportsToPosition    Position?      @relation("PositionHierarchy", fields: [reportsToPositionId], references: [id])
  subordinatePositions Position[]     @relation("PositionHierarchy")
  effectiveFrom        DateTime       @default(now())
  effectiveTo          DateTime?

  currentHolders       Employee[]     @relation("PositionHolder")
  assignments          Assignment[]
  requestedForRecruitment RecruitmentRequest[] @relation("RequestedPosition")
  requesterForRecruitment RecruitmentRequest[] @relation("RequesterPosition")
  recruitmentDecisions RecruitmentRequest[] @relation("RecruitmentDecisionPosition")
  recruitmentDeptHeadDecisions RecruitmentRequest[] @relation("RecruitmentDeptHeadDecisionPosition")
  movementRequestsAsCurrent  MovementRequest[] @relation("MovementCurrentPosition")
  movementRequestsAsProposed MovementRequest[] @relation("MovementProposedPosition")
  movementRequestsAsRequesterPosition MovementRequest[] @relation("MovementRequesterPosition")
  movementRequestsDecisions  MovementRequest[] @relation("MovementDecisionPosition")
  movementRequestsDeptHeadDecisions MovementRequest[] @relation("MovementDeptHeadDecisionPosition")
  contractRecommendations    Contract[] @relation("ContractRecommendationPosition")
  contractDecisions          Contract[] @relation("ContractDecisionPosition")
  renewalSnapshotOf              ContractRenewalCase[] @relation("RenewalSnapshotPosition")
  renewalP1PositionOf             ContractRenewalCase[] @relation("RenewalP1Position")
  renewalP2PositionOf             ContractRenewalCase[] @relation("RenewalP2Position")
  renewalDeptHeadPositionOf       ContractRenewalCase[] @relation("RenewalDeptHeadPosition")
  renewalDeptHeadProposedPositionOf ContractRenewalCase[] @relation("RenewalDeptHeadProposedPosition")
  renewalDecisionPositionOf       ContractRenewalCase[] @relation("RenewalDecisionPosition")
}

model Assignment {
  id                    String           @id @default(cuid())
  employeeId            String
  employee              Employee         @relation("EmployeeAssignments", fields: [employeeId], references: [id])
  positionId            String
  position              Position         @relation(fields: [positionId], references: [id])
  assignmentType        AssignmentType
  primaryAssignmentFlag Boolean          @default(false)
  status                AssignmentStatus @default(ACTIVE)
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  createdAt             DateTime         @default(now())

  fulfillment           RecruitmentRequestFulfillment?
  movementImplementation MovementRequest?
  movementCurrentAssignmentOf MovementRequest[] @relation("MovementCurrentAssignment")
  renewalCasesAsPrimaryAssignment ContractRenewalCase[]
}

// ---------- Phase 2: Recruitment Request (DEC-013, DM-21..23, WF-13..14) ----------

model RecruitmentRequest {
  id                       String                   @id @default(cuid())
  requestNumber            String                   @unique
  requestDate              DateTime
  reasonCode               RecruitmentReasonCode
  departmentId             String
  department               OrgUnit                  @relation(fields: [departmentId], references: [id])
  // Removed from the submitter's form on direct user request — the
  // requester no longer picks Job themselves. The active HR Manager sets it
  // as part of the Approve decision instead (decideRecruitmentRequest),
  // since it's still needed to filter candidate Positions when creating the
  // Employee later. Nullable so a request can exist in Submitted/Under
  // Review with no Job chosen yet.
  jobId                    String?
  job                      Job?                     @relation(fields: [jobId], references: [id])
  // Specific approved seat, when one is already known/vacant (DM-21: "when
  // available") — otherwise HR resolves a Position at fulfillment time.
  requestedPositionId      String?
  requestedPosition        Position?                @relation("RequestedPosition", fields: [requestedPositionId], references: [id])
  shiftCode                ShiftCode
  requestedHeadcount       Int
  jobDescriptionSnapshot   String
  educationRequirementCode EducationRequirementCode
  workExperienceBand       WorkExperienceBand
  ageBand                  AgeBand
  genderRequirement        Gender?
  requestedJobLevel        RequestedJobLevel
  specialCriteria          String?
  status                   RecruitmentRequestStatus @default(DRAFT)

  requesterEmployeeId      String
  requesterEmployee        Employee                 @relation("RecruitmentRequester", fields: [requesterEmployeeId], references: [id])
  // The Position through which the requester was acting when submitting —
  // authority/approvals must retain Position context, never just the person.
  requesterPositionId      String?
  requesterPosition        Position?                @relation("RequesterPosition", fields: [requesterPositionId], references: [id])

  submittedAt              DateTime?
  submittedByAccountId     String?
  submittedByAccount       Account?                 @relation("RecruitmentSubmittedBy", fields: [submittedByAccountId], references: [id])
  // Department Manager/Head (Job level 3B, scoped to this request's own
  // department) decision — runs before the HR Manager ever sees the
  // request. Same evidence shape as HR Manager's own decision fields below,
  // kept separate so both stages' evidence survive independently even
  // though they share the same REJECTED/RETURNED status outcomes.
  deptHeadDecisionAt          DateTime?
  deptHeadDecisionByAccountId String?
  deptHeadDecisionByAccount   Account?                 @relation("RecruitmentDeptHeadDecisionBy", fields: [deptHeadDecisionByAccountId], references: [id])
  deptHeadDecisionPositionId  String?
  deptHeadDecisionPosition    Position?                @relation("RecruitmentDeptHeadDecisionPosition", fields: [deptHeadDecisionPositionId], references: [id])
  deptHeadDecisionNote        String?
  // WF-15: only the Employee occupying an active HR Manager Position may
  // decide (approve/reject/return). approvedByAccountId records who (the
  // login used); decisionPositionId records the specific HR Manager Position
  // that gave them authority for THIS decision (WF-02/WF-05 — required when
  // an Employee holds more than one qualifying Position).
  approvedAt               DateTime?
  approvedByAccountId      String?
  approvedByAccount        Account?                 @relation("RecruitmentApprovedBy", fields: [approvedByAccountId], references: [id])
  decisionPositionId       String?
  decisionPosition         Position?                @relation("RecruitmentDecisionPosition", fields: [decisionPositionId], references: [id])
  decisionNote             String?

  // DM-25: cancellation is a distinct action from Approve/Reject/Return.
  // Requester, HR Manager or HR Admin may cancel from an eligible state
  // (never Filled/Closed/already-Cancelled); the request row is never
  // deleted and existing fulfillment links are always preserved.
  cancelledAt              DateTime?
  cancelledByAccountId     String?
  cancelledByAccount       Account?                 @relation("RecruitmentCancelledByAccount", fields: [cancelledByAccountId], references: [id])
  cancelledByEmployeeId    String?
  cancelledByEmployee      Employee?                @relation("RecruitmentCancelledByEmployee", fields: [cancelledByEmployeeId], references: [id])
  cancellationAuthority    CancellationAuthority?
  cancellationReason       String?
  previousStatus           RecruitmentRequestStatus?

  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  fulfillments             RecruitmentRequestFulfillment[]
}

// DM-23: supports multiple Employees per request, up to requestedHeadcount.
// filled_count/remaining_count are always derived from this table, never
// stored — see src/lib/recruitment.ts.
model RecruitmentRequestFulfillment {
  id                   String             @id @default(cuid())
  recruitmentRequestId String
  recruitmentRequest   RecruitmentRequest @relation(fields: [recruitmentRequestId], references: [id])
  employeeId           String             @unique
  employee             Employee           @relation(fields: [employeeId], references: [id])
  assignmentId         String             @unique
  assignment           Assignment         @relation(fields: [assignmentId], references: [id])
  linkedAt             DateTime           @default(now())
  linkedByAccountId    String
  linkedByAccount      Account            @relation(fields: [linkedByAccountId], references: [id])
}

// ---------- Phase 2: Movement Request (LIF-04) ----------
// WF-17 decision-to-execution pattern: an authorized manager (or HR Admin)
// submits/recommends -> the active HR Manager Position approves or rejects
// -> HR Admin executes the effective-dated Assignment change. This is a
// *formal* path alongside the existing direct "Pindahkan ke Posisi Baru"
// HR-Admin action on the Employee page (kept as an administrative
// shortcut/correction tool, same direct-vs-formal-request precedent as
// DEC-014 for Employee creation) — see docs/DECISIONS.md.
model MovementRequest {
  id                       String                @id @default(cuid())
  requestNumber            String                @unique
  employeeId               String
  employee                 Employee              @relation("MovementEmployee", fields: [employeeId], references: [id])
  movementType             MovementType
  // Captured at submission time from Employee.currentPositionId — a
  // snapshot, since the employee's actual current position could change
  // before this request is decided/executed.
  currentPositionId        String
  currentPosition          Position              @relation("MovementCurrentPosition", fields: [currentPositionId], references: [id])
  // Perubahan Posisi refactor: the specific Assignment being changed —
  // required so execution acts on exactly the Assignment the requester
  // identified, not whatever happens to be "the Primary" at execution time
  // (which could differ if something else changed in between). Nullable
  // only because pre-refactor rows predate this field.
  currentAssignmentId      String?
  currentAssignment        Assignment?           @relation("MovementCurrentAssignment", fields: [currentAssignmentId], references: [id])
  // Required for every movementType, incl. STATUS_CHANGE (where it's the
  // same as currentPositionId — no position change, only employmentStatus).
  proposedPositionId       String
  proposedPosition         Position              @relation("MovementProposedPosition", fields: [proposedPositionId], references: [id])
  // Only meaningful/required when movementType is STATUS_CHANGE — a legacy
  // type, no longer offered by the Perubahan Posisi submit form.
  proposedEmploymentStatus EmploymentStatus?
  proposedEffectiveDate    DateTime
  requestReason            String
  status                   MovementRequestStatus @default(SUBMITTED)

  requesterEmployeeId      String
  requesterEmployee        Employee              @relation("MovementRequester", fields: [requesterEmployeeId], references: [id])
  requesterPositionId      String?
  requesterPosition        Position?             @relation("MovementRequesterPosition", fields: [requesterPositionId], references: [id])
  submittedAt              DateTime              @default(now())
  submittedByAccountId     String
  submittedByAccount       Account               @relation("MovementSubmittedBy", fields: [submittedByAccountId], references: [id])

  // Perubahan Posisi refactor: Department Head 3B decision (first stage),
  // same evidence shape as the HR Manager's own decision fields below —
  // kept separate so both stages' evidence survive independently.
  deptHeadDecisionAt          DateTime?
  deptHeadDecisionByAccountId String?
  deptHeadDecisionByAccount   Account?              @relation("MovementDeptHeadDecisionBy", fields: [deptHeadDecisionByAccountId], references: [id])
  deptHeadDecisionPositionId  String?
  deptHeadDecisionPosition    Position?             @relation("MovementDeptHeadDecisionPosition", fields: [deptHeadDecisionPositionId], references: [id])
  deptHeadDecisionNote        String?

  // LIF-04: "HR Manager approves or rejects" (second/final stage) —
  // decisionPositionId records which active HR Manager Position gave
  // authority (WF-02/WF-05), same pattern as RecruitmentRequest.
  decisionAt               DateTime?
  decisionByAccountId      String?
  decisionByAccount        Account?              @relation("MovementDecisionBy", fields: [decisionByAccountId], references: [id])
  decisionPositionId       String?
  decisionPosition         Position?             @relation("MovementDecisionPosition", fields: [decisionPositionId], references: [id])
  decisionNote             String?

  // Perubahan Posisi refactor: HR-only supporting fields (FR-HC-01-09's
  // "Absensi 3 Bulan Terakhir" + evaluation reference) — added/verified by
  // HR Admin, never visible or editable by the requester. Evaluation
  // reference is mandatory for Promosi (validated in the action, not here).
  attendanceAlpha             Int?
  attendanceSakit             Int?
  attendanceIjin              Int?
  attendanceIjinHalfDay        Int?
  attendanceCuti               Int?
  performanceEvaluationRef      String?
  performanceEvaluationFileId   String?               @unique
  performanceEvaluationFile     FileObject?           @relation(fields: [performanceEvaluationFileId], references: [id])
  hrConfidentialNotes           String?

  // LIF-04: "HR Admin executes the future/effective-dated Position
  // Assignment and preserves previous records" — implementedAssignmentId
  // points at the new Assignment row created by execution (old Assignment
  // is closed, never overwritten, same as the direct Movement action).
  implementedAt            DateTime?
  implementedByAccountId   String?
  implementedByAccount     Account?              @relation("MovementImplementedBy", fields: [implementedByAccountId], references: [id])
  implementedAssignmentId  String?               @unique
  implementedAssignment    Assignment?           @relation(fields: [implementedAssignmentId], references: [id])

  // DM-25-style cancellation, reusing the same CancellationAuthority enum
  // as Recruitment for consistency. Only eligible from SUBMITTED/APPROVED.
  cancelledAt              DateTime?
  cancelledByAccountId     String?
  cancelledByAccount       Account?              @relation("MovementCancelledByAccount", fields: [cancelledByAccountId], references: [id])
  cancelledByEmployeeId    String?
  cancelledByEmployee      Employee?             @relation("MovementCancelledByEmployee", fields: [cancelledByEmployeeId], references: [id])
  cancellationAuthority    CancellationAuthority?
  cancellationReason       String?
  previousStatus           MovementRequestStatus?

  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  // DM-10/LIF-13: set only for a draft auto-created by the Contract Renewal
  // workflow (Mutasi/Demosi outcome) — reverse of ContractRenewalCase's
  // linkedMovementRequestId.
  renewalCase              ContractRenewalCase?  @relation("RenewalLinkedMovement")
}

// ---------- Phase 2: Onboarding Case (LIF-03, Data Fields Blueprint "12 Onboarding") ----------
// Created automatically alongside every new Employee (direct creation or
// Recruitment fulfillment) — "reuse the Employee and initial Position
// Assignment; do not re-enter identity data." Three completion flags, each
// with its own admin owner per the blueprint (People & Payroll / Training /
// Assets); candidate_id, asset_requirement_profile, and other fields tied to
// Candidate/Competency/Asset datasets that don't exist yet in this app are
// deliberately not modeled — same reasoning as Movement Request's deferred
// Evaluation/Competency fields.
model OnboardingCase {
  id                       String    @id @default(cuid())
  caseNumber               String    @unique
  employeeId               String    @unique
  employee                 Employee  @relation(fields: [employeeId], references: [id])
  plannedStartDate         DateTime

  contractComplete             Boolean   @default(false)
  contractCompletedAt          DateTime?
  contractCompletedByAccountId  String?
  contractCompletedByAccount    Account? @relation("OnboardingContractCompletedBy", fields: [contractCompletedByAccountId], references: [id])

  mandatoryMaterialComplete        Boolean   @default(false)
  mandatoryMaterialDueDate         DateTime?
  mandatoryMaterialCompletedAt     DateTime?
  mandatoryMaterialCompletedByAccountId String?
  mandatoryMaterialCompletedByAccount   Account? @relation("OnboardingTrainingCompletedBy", fields: [mandatoryMaterialCompletedByAccountId], references: [id])

  assetsComplete             Boolean   @default(false)
  assetsCompletedAt          DateTime?
  assetsCompletedByAccountId  String?
  assetsCompletedByAccount    Account? @relation("OnboardingAssetsCompletedBy", fields: [assetsCompletedByAccountId], references: [id])

  // Set automatically the moment all three flags become true — never
  // hand-set, and overall_status (Not Started/In Progress/Overdue/Complete)
  // is computed live from these fields, never stored (src/lib/onboarding.ts).
  completedAt              DateTime?

  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

// ---------- Phase 2: Contract + renewal pipeline (WF-10, LIF-08..12) ----------
// Data Fields Blueprint "08 Contracts" has no separate renewal-case
// dataset — its own contract_id/drafted_at/released_at/signed_at fields are
// the only place WF-10's pipeline can live, so this single model plays two
// roles depending on where it sits in that pipeline: (1) an ACTIVE contract
// nearing its own end_date, moving through the Department-Manager-
// recommends -> HR-Manager-decides states; (2) once approved, a brand-new
// Contract row moving Draft -> Released -> Signed -> Active while the old
// one (linked via renewedFromContractId) flips to Ended. "Not Renewed"
// records the reason (LIF-12) but does not create an actual offboarding
// handoff — Offboarding doesn't exist yet in this app; revisit when it does.
model Contract {
  id                  String                         @id @default(cuid())
  contractNumber      String                         @unique
  employeeId          String
  employee            Employee                       @relation("EmployeeContracts", fields: [employeeId], references: [id])
  contractType        EmploymentStatus
  startDate           DateTime
  // Blueprint: "blank for indefinite contract" — null means PKWTT/indefinite.
  endDate             DateTime?
  status              ContractStatus                 @default(DRAFT)

  // Set when this Contract is a renewal — the Contract it replaces.
  renewedFromContractId String?                       @unique
  renewedFromContract   Contract?                     @relation("ContractRenewalChain", fields: [renewedFromContractId], references: [id])
  renewedByContract     Contract?                     @relation("ContractRenewalChain")

  // Department Manager recommendation (WF-10/LIF-09 step 1). WF-02:
  // "approval evidence" always records the Position context too, not just
  // the person — same pattern as Recruitment/Movement requesters.
  reviewRequestedAt          DateTime?
  recommendationSubmittedAt  DateTime?
  recommendationByEmployeeId String?
  recommendationByEmployee   Employee?                      @relation("ContractRecommendationBy", fields: [recommendationByEmployeeId], references: [id])
  recommendationByPositionId String?
  recommendationByPosition   Position?                      @relation("ContractRecommendationPosition", fields: [recommendationByPositionId], references: [id])
  recommendation             ContractRenewalRecommendation?
  recommendationNote         String?

  // HR Manager decision (WF-10/LIF-09 step 2) — same Position-derived-only
  // authority as Recruitment (WF-15) and Movement, reused for consistency.
  decisionAt           DateTime?
  decisionByAccountId  String?
  decisionByAccount    Account?  @relation("ContractDecisionBy", fields: [decisionByAccountId], references: [id])
  decisionPositionId   String?
  decisionPosition     Position? @relation("ContractDecisionPosition", fields: [decisionPositionId], references: [id])
  decisionNote         String?
  notRenewedReason     String?

  // HR Admin prepares/releases/administers (WF-10/LIF-09 step 3); Employee
  // signs their own contract (blueprint: signed_at's Primary Owner is
  // "Employee"). No separate actor FK for these three — the audit log
  // already records who, matching the blueprint's own thin field set here.
  draftedAt   DateTime?
  releasedAt  DateTime?
  signedAt    DateTime?
  activatedAt DateTime?

  contractFileId String?     @unique
  contractFile   FileObject? @relation(fields: [contractFileId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  renewalCaseAsCurrentContract   ContractRenewalCase? @relation("RenewalCurrentContract")
  renewalCaseAsGeneratedContract ContractRenewalCase? @relation("RenewalGeneratedContract")
}

// ---------- Controls: audit, import, private files ----------

model AuditLog {
  id                String      @id @default(cuid())
  eventAt           DateTime    @default(now())
  actorAccountId    String?
  actorAccount      Account?    @relation(fields: [actorAccountId], references: [id])
  action            AuditAction
  datasetName       String
  recordId          String?
  fieldName         String?
  oldValueMasked    String?
  newValueMasked    String?
  reason            String?
  sessionOrDeviceId String?
}

model ImportBatch {
  id                  String       @id @default(cuid())
  importType          String
  uploadedByAccountId String
  uploadedByAccount   Account      @relation(fields: [uploadedByAccountId], references: [id])
  sourceFileName      String
  uploadedAt          DateTime     @default(now())
  totalRows           Int
  validRows           Int
  errorRows           Int
  duplicateRows       Int          @default(0)
  importStatus        ImportStatus @default(UPLOADED)
  previewConfirmedAt  DateTime?
  postedAt            DateTime?

  rows                ImportRow[]
}

model ImportRow {
  id              String      @id @default(cuid())
  importBatchId   String
  importBatch     ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  rowNumber       Int
  rawData         String
  isValid         Boolean
  rejectionReason String?
  // CTL-13: generalized from the Phase 0 Employee-only import — every
  // dataset's importer sets this once its row is committed, whether that
  // created a brand-new record or updated an existing one (matched by the
  // dataset's natural key).
  rowAction       String?
  createdRecordId String?
}

model FileObject {
  id                  String      @id @default(cuid())
  storageKey          String      @unique
  originalFileName    String
  mimeType            String
  sizeBytes           Int
  sensitivity         Sensitivity @default(RESTRICTED)
  employeeId          String?
  employee            Employee?   @relation(fields: [employeeId], references: [id])
  uploadedByAccountId String
  uploadedByAccount   Account     @relation(fields: [uploadedByAccountId], references: [id])
  category            String?
  issueDate           DateTime?
  expiryDate          DateTime?
  confidential        Boolean     @default(true)
  createdAt           DateTime    @default(now())

  employeeKtpOf       Employee?   @relation("EmployeeKtpFile")
  employeeKkOf        Employee?   @relation("EmployeeKkFile")
  contractOf          Contract?
  movementPerformanceEvaluationOf MovementRequest?
}
